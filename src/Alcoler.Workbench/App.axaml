<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Alcoler.Workbench.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/AlcolerTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button.accentAction">
            <Setter Property="Background" Value="{DynamicResource AlcolerAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource AlcolerAccentText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadius}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accentAction:pointerover">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Button.subtleAction">
            <Setter Property="Background" Value="{DynamicResource AlcolerTransparent}" />
            <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadiusSmall}" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style Selector="Button.subtleAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
        </Style>
    </Application.Styles>
</Application>
