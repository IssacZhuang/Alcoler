<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Alcoler.Workbench.MainWindow"
        x:DataType="vm:WorkbenchViewModel"
        xmlns:vm="using:Alcoler.Workbench.ViewModel"
        xmlns:views="using:Alcoler.Workbench.Views"
        Title="Alcoler"
        Width="1440" Height="900" MinWidth="1100" MinHeight="640"
        Background="{DynamicResource AlcolerBackground}">

  <Grid ColumnDefinitions="260,4,*,4,300">
    <views:SidebarView Grid.Column="0" />
    <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                  Background="{DynamicResource AlcolerBorder}" />
    <Grid Grid.Column="2" RowDefinitions="Auto,*,4,Auto">
      <StackPanel Grid.Row="0">
        <Border IsVisible="{Binding Banner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="{DynamicResource AlcolerError}">
          <Grid ColumnDefinitions="*,Auto" Margin="14,6,8,6">
            <TextBlock Grid.Column="0" Text="{Binding Banner}" FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AlcolerAccentText}" />
            <Button Grid.Column="1" Classes="subtleAction" Content="Dismiss"
                    Foreground="{DynamicResource AlcolerAccentText}"
                    Click="OnDismissWorkbenchBannerClick" />
          </Grid>
        </Border>
        <Border Background="{DynamicResource AlcolerSurface}"
                BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="0,0,0,1"
                Padding="14,8">
          <Grid DataContext="{Binding Active}" x:DataType="vm:ConversationViewModel"
                ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto"
                ColumnSpacing="10">
            <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                       TextTrimming="CharacterEllipsis" MaxWidth="360" VerticalAlignment="Center"
                       Foreground="{DynamicResource AlcolerTextPrimary}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8"
                       Fill="{Binding PhaseText, Converter={StaticResource AlcolerPhaseBrush}}" />
              <TextBlock x:Name="PART_PhaseText" Text="{Binding PhaseText}" FontSize="12"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource AlcolerTextSecondary}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding ModelText}" FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AlcolerTextSecondary}" />
            <Border Grid.Column="4" x:Name="PART_ContextMeterTrack" Width="84" Height="4"
                    CornerRadius="{DynamicResource AlcolerRadiusSmall}"
                    Background="{DynamicResource AlcolerSurfaceHigh}" ClipToBounds="True"
                    VerticalAlignment="Center" ToolTip.Tip="{Binding ContextUsageText}">
              <Border x:Name="PART_ContextMeterFill" Height="4"
                      CornerRadius="{DynamicResource AlcolerRadiusSmall}"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Width="{Binding ContextUsagePercent, Converter={StaticResource AlcolerPercentToWidth}, ConverterParameter=84}"
                      Background="{Binding ContextUsagePercent, Converter={StaticResource AlcolerContextUsageBrush}}" />
            </Border>
            <Border Grid.Column="5" x:Name="PART_QueueBadge" CornerRadius="8" Padding="8,2"
                    Background="{DynamicResource AlcolerSurfaceHigh}"
                    VerticalAlignment="Center"
                    IsVisible="{Binding HasQueuedInput}" ToolTip.Tip="Queued inputs">
              <TextBlock Text="{Binding Queue.Count}" FontSize="11"
                         Foreground="{DynamicResource AlcolerTextSecondary}" />
            </Border>
            <Button Grid.Column="6" Classes="subtleAction" Content="Refresh"
                    Click="OnRefreshClick" VerticalAlignment="Center" />
            <Button Grid.Column="7" Classes="subtleAction" Content="Settings"
                    Click="OnSettingsClick" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Border IsVisible="{Binding Active.Banner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="{DynamicResource AlcolerError}">
          <Grid ColumnDefinitions="*,Auto" Margin="14,6,8,6">
            <TextBlock Grid.Column="0" Text="{Binding Active.Banner}" FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AlcolerAccentText}" />
            <Button Grid.Column="1" Classes="subtleAction" Content="Dismiss"
                    Foreground="{DynamicResource AlcolerAccentText}"
                    Click="OnDismissConversationBannerClick" />
          </Grid>
        </Border>
      </StackPanel>
      <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto">
        <views:TimelineView Grid.Row="0" DataContext="{Binding Active}" />
        <views:InteractionAreaView Grid.Row="1" DataContext="{Binding Active}" />
        <views:ComposerView Grid.Row="2" DataContext="{Binding Active}" />
      </Grid>
      <GridSplitter Grid.Row="2" ResizeDirection="Rows" Background="{DynamicResource AlcolerBorder}" />
      <Border Grid.Row="3" Height="220" MinHeight="120" MaxHeight="520"
              Background="{DynamicResource AlcolerSurface}"
              BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="0,1,0,0">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="0,0,0,1"
                  Padding="10,4">
            <TextBlock Text="Terminal" FontSize="12" Foreground="{DynamicResource AlcolerTextSecondary}" />
          </Border>
          <views:TerminalView Grid.Row="1" DataContext="{Binding Terminal}" />
        </Grid>
      </Border>
    </Grid>
    <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="{DynamicResource AlcolerBorder}" />
    <Border Grid.Column="4" Background="{DynamicResource AlcolerSurface}"
            BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="1,0,0,0">
      <TabControl Background="Transparent" Padding="0">
        <TabItem Header="Git">
          <views:GitPaneView DataContext="{Binding GitPane}" />
        </TabItem>
        <TabItem Header="Browser">
          <views:BrowserPaneView DataContext="{Binding BrowserPane}" />
        </TabItem>
      </TabControl>
    </Border>
  </Grid>
</Window>
