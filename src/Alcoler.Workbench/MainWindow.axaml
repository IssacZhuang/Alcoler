<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Alcoler.Workbench.MainWindow"
        x:DataType="vm:WorkbenchViewModel"
        xmlns:vm="using:Alcoler.Workbench.ViewModel"
        xmlns:views="using:Alcoler.Workbench.Views"
        Title="Alcoler"
        Width="1440" Height="820" MinWidth="980" MinHeight="620"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AlcolerChrome}">
  <Window.Styles>
    <Style Selector="Button.paneTab">
      <Setter Property="Background" Value="{DynamicResource AlcolerTransparent}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="{DynamicResource AlcolerFontSmall}" />
    </Style>
    <Style Selector="Button.paneTab.active">
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.windowClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerError}" />
    </Style>
  </Window.Styles>
  <Grid x:Name="ShellGrid" Margin="4">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="264" MinWidth="264" />
      <ColumnDefinition Width="4" />
      <ColumnDefinition Width="*" MinWidth="340" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="0" />
    </Grid.ColumnDefinitions>
    <views:SidebarView x:Name="Sidebar" Grid.Column="0" />
    <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" ResizeDirection="Columns"
                  DragCompleted="OnSidebarSplitterDragCompleted" />
    <Border Grid.Column="2" Background="{DynamicResource AlcolerBackground}"
            BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="1"
            CornerRadius="5" ClipToBounds="True">
      <Grid x:Name="MainCard">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="48" />
          <RowDefinition Height="*" />
          <RowDefinition Height="0" />
          <RowDefinition Height="0" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="12,8,12,0" Padding="10,7"
                CornerRadius="{DynamicResource AlcolerRadiusLarge}"
                Background="{DynamicResource AlcolerCard}"
                BorderBrush="{DynamicResource AlcolerError}" BorderThickness="1"
                IsVisible="{Binding Banner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding Banner}" FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center" Foreground="{DynamicResource AlcolerError}" />
            <Button Grid.Column="1" Classes="icon tiny" Click="OnDismissWorkbenchBannerClick" ToolTip.Tip="Dismiss">
              <Path Classes="icon small" Data="{StaticResource AlcolerIconX}" />
            </Button>
          </Grid>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource AlcolerPanel}"
                BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="0,0,0,1"
                PointerPressed="OnTitleBarPointerPressed">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,0,4,0" ColumnSpacing="4">
            <Button Classes="icon" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Toggle sidebar (Ctrl+B)"
                    AutomationProperties.Name="Toggle sidebar">
              <Path Classes="icon small" Data="{StaticResource AlcolerIconFolder}" />
            </Button>
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <TextBlock Text="{Binding Active.HeaderTitle}" FontSize="13" FontWeight="Medium"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         IsVisible="{Binding Active, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Text="New task" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"
                         IsVisible="{Binding Active, Converter={x:Static ObjectConverters.IsNull}}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0"
                          IsVisible="{Binding Active, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                         Fill="{Binding Active.PhaseText, Converter={StaticResource AlcolerPhaseBrush}}" />
                <TextBlock x:Name="PART_PhaseText" Text="{Binding Active.PhaseText}" FontSize="11"
                           VerticalAlignment="Center" Foreground="{DynamicResource AlcolerTextSecondary}" />
                <Border x:Name="PART_QueueBadge" CornerRadius="{DynamicResource AlcolerRadiusFull}" Padding="6,1"
                        Background="{DynamicResource AlcolerSurfaceHigh}" VerticalAlignment="Center"
                        IsVisible="{Binding Active.HasQueuedInput}" ToolTip.Tip="Queued inputs">
                  <TextBlock Text="{Binding Active.Queue.Count}" FontSize="10" />
                </Border>
              </StackPanel>
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <Button Classes="icon" Click="OnRefreshClick" ToolTip.Tip="Refresh sessions" AutomationProperties.Name="Refresh sessions">
                <Path Classes="icon small" Data="{StaticResource AlcolerIconRefresh}" />
              </Button>
              <Button Classes="icon" Command="{Binding ToggleTerminalCommand}"
                      Classes.active="{Binding IsTerminalVisible}" ToolTip.Tip="Toggle terminal (Ctrl+J)"
                      AutomationProperties.Name="Toggle terminal">
                <Path Classes="icon small" Data="{StaticResource AlcolerIconTerminal}" />
              </Button>
              <Button Classes="icon" Command="{Binding ToggleSidePaneCommand}"
                      Classes.active="{Binding IsSidePaneVisible}" ToolTip.Tip="Toggle side panel"
                      AutomationProperties.Name="Toggle side panel">
                <Path Classes="icon small" Data="{StaticResource AlcolerIconPanel}" />
              </Button>
              <Border Width="92" IsVisible="{Binding !IsSidePaneVisible}" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="2" RowDefinitions="*,Auto,Auto"
              IsVisible="{Binding Active, Converter={x:Static ObjectConverters.IsNotNull}}">
          <views:TimelineView Grid.Row="0" DataContext="{Binding Active}" />
          <views:InteractionAreaView Grid.Row="1" DataContext="{Binding Active}" />
          <views:ComposerView Grid.Row="2" DataContext="{Binding Active}" />
        </Grid>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                    IsVisible="{Binding Active, Converter={x:Static ObjectConverters.IsNull}}">
          <TextBlock Text="What can I help you build?" FontSize="24" FontWeight="Medium" HorizontalAlignment="Center" />
          <TextBlock Text="Start a task in your project, or continue a conversation." FontSize="13"
                     HorizontalAlignment="Center" Foreground="{DynamicResource AlcolerTextSecondary}" />
          <Button Classes="outline" Click="OnNewSessionClick" HorizontalAlignment="Center" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="icon small" Data="{StaticResource AlcolerIconCirclePlus}" />
              <TextBlock Text="New task" FontSize="13" />
              <TextBlock Text="Ctrl+N" FontSize="12" Foreground="{DynamicResource AlcolerTextTertiary}" Margin="16,0,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>
        <GridSplitter Grid.Row="3" ResizeDirection="Rows" IsVisible="{Binding IsTerminalVisible}"
                      DragCompleted="OnTerminalSplitterDragCompleted" />
        <Border Grid.Row="4" Background="{DynamicResource AlcolerTerminalBackground}"
                BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="0,1,0,0"
                IsVisible="{Binding IsTerminalVisible}">
          <views:TerminalView DataContext="{Binding Terminal}" />
        </Border>
      </Grid>
    </Border>
    <GridSplitter Grid.Column="3" ResizeDirection="Columns" Width="4"
                  IsVisible="{Binding IsSidePaneVisible}" DragCompleted="OnSidePaneSplitterDragCompleted" />
    <Border Grid.Column="4" Background="{DynamicResource AlcolerBackground}"
            BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="1"
            CornerRadius="5" ClipToBounds="True" IsVisible="{Binding IsSidePaneVisible}">
      <Grid RowDefinitions="48,*">
        <Border Background="{DynamicResource AlcolerPanel}" BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto" Margin="8,0,6,0" PointerPressed="OnTitleBarPointerPressed">
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <Button Classes="paneTab" Classes.active="{Binding IsGitPaneSelected}" Command="{Binding ShowGitPaneCommand}" Content="Changes" />
              <Button Classes="paneTab" Classes.active="{Binding IsBrowserPaneSelected}" Command="{Binding ShowBrowserPaneCommand}" Content="Browser" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Classes="icon tiny" Command="{Binding CloseSidePaneCommand}" ToolTip.Tip="Close panel" AutomationProperties.Name="Close panel">
                <Path Classes="icon small" Data="{StaticResource AlcolerIconX}" />
              </Button>
              <Border Width="92" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <Grid IsVisible="{Binding IsGitPaneSelected}">
            <Grid IsVisible="{Binding GitPane, Converter={x:Static ObjectConverters.IsNotNull}}">
              <views:GitPaneView DataContext="{Binding GitPane}" />
            </Grid>
            <TextBlock Text="Select a task to view changes." FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource AlcolerTextSecondary}" IsVisible="{Binding GitPane, Converter={x:Static ObjectConverters.IsNull}}" />
          </Grid>
          <Grid IsVisible="{Binding IsBrowserPaneSelected}">
            <Grid IsVisible="{Binding BrowserPane, Converter={x:Static ObjectConverters.IsNotNull}}">
              <views:BrowserPaneView DataContext="{Binding BrowserPane}" />
            </Grid>
            <TextBlock Text="Select a task to view the browser." FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource AlcolerTextSecondary}" IsVisible="{Binding BrowserPane, Converter={x:Static ObjectConverters.IsNull}}" />
          </Grid>
        </Grid>
      </Grid>
    </Border>
    <StackPanel Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,10,4,0" Spacing="2">
      <Button Classes="icon" Click="OnMinimizeClick" ToolTip.Tip="Minimize" AutomationProperties.Name="Minimize">
        <Path Classes="icon small" Data="{StaticResource AlcolerIconMinimize}" />
      </Button>
      <Button Classes="icon" Click="OnMaximizeClick" ToolTip.Tip="Maximize or restore" AutomationProperties.Name="Maximize or restore">
        <Path Classes="icon small" Data="{StaticResource AlcolerIconMaximize}" />
      </Button>
      <Button Classes="icon windowClose" Click="OnCloseClick" ToolTip.Tip="Close" AutomationProperties.Name="Close">
        <Path Classes="icon small" Data="{StaticResource AlcolerIconX}" />
      </Button>
    </StackPanel>
  </Grid>
</Window>
