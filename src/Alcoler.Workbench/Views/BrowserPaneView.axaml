<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alcoler.Workbench.ViewModel"
             xmlns:controls="using:Alcoler.Workbench.Controls"
             x:Class="Alcoler.Workbench.Views.BrowserPaneView"
             x:DataType="vm:BrowserPaneViewModel">
  <DockPanel Background="{DynamicResource AlcolerBackground}">
    <Grid x:Name="PART_BrowserToolbar" DockPanel.Dock="Top" Height="48" Margin="12,0"
          ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <Button x:Name="PART_BrowserRefresh" Classes="icon" Command="{Binding RefreshCommand}"
              ToolTip.Tip="Refresh browser status and screenshot" VerticalAlignment="Center">
        <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconRefresh}" />
      </Button>
      <TextBox Grid.Column="1" x:Name="PART_BrowserAddress" Text="{Binding Address, Mode=TwoWay}"
               Watermark="Enter a URL" IsEnabled="{Binding CanInteract}" KeyDown="OnAddressKeyDown"
               ToolTip.Tip="{Binding Url}" Height="28" MinHeight="28" Padding="8,3"
               FontSize="{DynamicResource AlcolerFontSmall}" VerticalContentAlignment="Center"
               VerticalAlignment="Center" CornerRadius="{DynamicResource AlcolerRadiusLarge}" />
      <Button Grid.Column="2" Classes="ghost" Command="{Binding TakeOverCommand}"
              Content="Take over" ToolTip.Tip="Bring the browser window to the front"
              Height="28" Padding="8,0" FontSize="{DynamicResource AlcolerFontSmall}"
              VerticalAlignment="Center" />
    </Grid>

    <Border DockPanel.Dock="Top" Margin="12,0,12,8" Padding="8"
            Background="{DynamicResource AlcolerSurface}" CornerRadius="{DynamicResource AlcolerRadius}"
            IsVisible="{Binding Banner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding Banner}" FontSize="{DynamicResource AlcolerFontSmall}"
                 TextWrapping="Wrap" Foreground="{DynamicResource AlcolerError}" />
    </Border>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="12,6,12,8">
      <TextBlock Text="{Binding Title}" FontSize="{DynamicResource AlcolerFontSmall}"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"
                 Foreground="{DynamicResource AlcolerTextTertiary}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{Binding StateText}" FontSize="{DynamicResource AlcolerFontSmall}"
                   Foreground="{DynamicResource AlcolerTextSecondary}" />
        <TextBlock Text="{Binding UpdatedText}" FontSize="{DynamicResource AlcolerFontSmall}"
                   Foreground="{DynamicResource AlcolerTextTertiary}" />
      </StackPanel>
    </Grid>

    <Border x:Name="PART_BrowserViewport" Margin="12,0" CornerRadius="{DynamicResource AlcolerRadius}"
            Background="{DynamicResource AlcolerPanel}" ClipToBounds="True">
      <Grid>
        <Image x:Name="PART_BrowserScreenshot" Source="{Binding Screenshot}" Stretch="Uniform"
               IsVisible="{Binding HasScreenshot}" />
        <StackPanel Spacing="10" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding !HasScreenshot}">
          <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconGlobe}" Width="48" Height="48"
                HorizontalAlignment="Center" Stroke="{DynamicResource AlcolerTextTertiary}" />
          <TextBlock Text="Browser" FontSize="{DynamicResource AlcolerFontSmall}" FontWeight="Medium"
                     HorizontalAlignment="Center" Foreground="{DynamicResource AlcolerTextPrimary}" />
          <TextBlock Text="No screenshot yet" FontSize="{DynamicResource AlcolerFontSmall}"
                     HorizontalAlignment="Center" Foreground="{DynamicResource AlcolerTextSecondary}" />
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
