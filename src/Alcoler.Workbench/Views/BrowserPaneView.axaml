<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alcoler.Workbench.ViewModel"
             x:Class="Alcoler.Workbench.Views.BrowserPaneView"
             x:DataType="vm:BrowserPaneViewModel">
  <DockPanel Background="{DynamicResource AlcolerPanel}">
    <Border DockPanel.Dock="Top" Margin="10,10,10,0" Padding="8,6"
            CornerRadius="{DynamicResource AlcolerRadiusLarge}"
            Background="{DynamicResource AlcolerCard}"
            BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Path Grid.Column="0" Classes="icon small" Data="{StaticResource AlcolerIconGlobe}" />
        <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource AlcolerTextSecondary}" />
            <TextBlock Text="{Binding UpdatedText}" FontSize="11"
                       Foreground="{DynamicResource AlcolerTextTertiary}" />
          </StackPanel>
          <TextBlock Text="{Binding Url}" FontSize="12"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Title}"
                     Foreground="{DynamicResource AlcolerTextPrimary}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="icon tiny" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
          <Path Classes="icon small" Data="{StaticResource AlcolerIconRefresh}" />
        </Button>
        <Button Grid.Column="3" Classes="outline" Content="Take over" FontSize="11" Padding="10,3"
                Command="{Binding TakeOverCommand}" />
      </Grid>
    </Border>
    <Border Margin="10" CornerRadius="{DynamicResource AlcolerRadiusLarge}"
            Background="{DynamicResource AlcolerBackground}" ClipToBounds="True">
      <Grid>
        <Image Source="{Binding Screenshot}" Stretch="Uniform"
               IsVisible="{Binding HasScreenshot}" />
        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding !HasScreenshot}">
          <Path Classes="icon" Data="{StaticResource AlcolerIconGlobe}" Width="24" Height="24"
                HorizontalAlignment="Center" Stroke="{DynamicResource AlcolerTextTertiary}" />
          <TextBlock Text="No screenshot yet" FontSize="12"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource AlcolerTextTertiary}" />
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
