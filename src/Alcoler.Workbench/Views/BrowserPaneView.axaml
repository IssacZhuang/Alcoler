<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alcoler.Workbench.ViewModel"
             x:Class="Alcoler.Workbench.Views.BrowserPaneView"
             x:DataType="vm:BrowserPaneViewModel">
  <DockPanel Background="{DynamicResource AlcolerSurface}">
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource AlcolerSurfaceHigh}"
            BorderBrush="{DynamicResource AlcolerBorder}"
            BorderThickness="0,0,0,1"
            Padding="10,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold"
                   VerticalAlignment="Center" Foreground="{DynamicResource AlcolerAccent}" />
        <TextBlock Grid.Column="1" Text="{Binding Url}" FontSize="12"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   ToolTip.Tip="{Binding Title}"
                   Foreground="{DynamicResource AlcolerTextSecondary}" />
        <Button Grid.Column="2" Classes="subtleAction" Content="Refresh"
                Command="{Binding RefreshCommand}" />
        <Button Grid.Column="3" Classes="accentAction" Content="Take over"
                Command="{Binding TakeOverCommand}" />
      </Grid>
    </Border>
    <Grid Margin="12">
      <Image Source="{Binding Screenshot}" Stretch="Uniform"
             IsVisible="{Binding HasScreenshot}" />
      <TextBlock Text="No screenshot yet" FontSize="12" IsVisible="{Binding !HasScreenshot}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource AlcolerTextSecondary}" />
    </Grid>
  </DockPanel>
</UserControl>
