<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Alcoler.Workbench.Controls"
             xmlns:converters="using:Alcoler.Workbench.Converters"
             xmlns:events="using:Alcoler.Contracts.Events"
             xmlns:vm="using:Alcoler.Workbench.ViewModel"
             x:Class="Alcoler.Workbench.Views.ComposerView"
             x:DataType="vm:ConversationViewModel">
  <UserControl.Styles>
    <Style Selector="RadioButton.segment">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="RadioButton.segment:checked">
      <Setter Property="Background" Value="{DynamicResource AlcolerAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerBackground}" />
    </Style>
    <Style Selector="Button.tiny">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource AlcolerError}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="6">
    <Border x:Name="QueueStrip"
            IsVisible="{Binding HasQueuedInput}"
            Background="{DynamicResource AlcolerSurface}"
            BorderBrush="{DynamicResource AlcolerBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8,4"
            MaxHeight="64">
      <ScrollViewer>
        <StackPanel Spacing="2">
          <TextBlock Text="Queued" FontSize="11" Opacity="0.55" />
          <ItemsControl x:Name="QueueList" ItemsSource="{Binding Queue}">
            <ItemsControl.Template>
              <ControlTemplate>
                <ItemsPresenter />
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="events:QueuedInput">
                <TextBlock Text="{Binding Text}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Background="{DynamicResource AlcolerSurface}"
            BorderBrush="{DynamicResource AlcolerBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
      <DockPanel>
        <DockPanel Dock="Bottom" Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="Context window usage">
              <controls:ContextMeter Width="72" Percent="{Binding ContextUsagePercent}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ContextUsageText}" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
            </StackPanel>
            <ComboBox x:Name="ModelSelector"
                      MinWidth="150"
                      ToolTip.Tip="{Binding ModelText}"
                      SelectionChanged="OnModelSelected">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ModelChoice">
                  <TextBlock Text="{Binding Display}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="ThoughtLevelSelector"
                      MinWidth="76"
                      ToolTip.Tip="Reasoning effort"
                      ItemsSource="{Binding ThoughtLevels}"
                      SelectedItem="{Binding ThoughtLevel, Mode=TwoWay}" />
            <Button Content="/compact" Classes="tiny" Click="OnCompactClick" ToolTip.Tip="Compact conversation history" VerticalAlignment="Center" />
            <Button x:Name="StopButton"
                    Content="Stop"
                    Classes="danger"
                    MinWidth="60"
                    IsVisible="{Binding Composer.IsTurnActive}"
                    Click="OnStopClick" />
            <Button x:Name="SendButton"
                    Content="Send"
                    MinWidth="60"
                    IsEnabled="{Binding Composer.CanSend}"
                    Click="OnSendClick" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <RadioButton GroupName="ComposerMode" Classes="segment" Content="Build"
                         IsChecked="{Binding Composer.Mode, Converter={x:Static converters:ComposerConverters.EnumEquals}, ConverterParameter=Build}" />
            <RadioButton GroupName="ComposerMode" Classes="segment" Content="Edit"
                         IsChecked="{Binding Composer.Mode, Converter={x:Static converters:ComposerConverters.EnumEquals}, ConverterParameter=Edit}" />
            <RadioButton GroupName="ComposerMode" Classes="segment" Content="Plan"
                         IsChecked="{Binding Composer.Mode, Converter={x:Static converters:ComposerConverters.EnumEquals}, ConverterParameter=Plan}" />
            <RadioButton GroupName="ComposerMode" Classes="segment" Content="Yolo"
                         IsChecked="{Binding Composer.Mode, Converter={x:Static converters:ComposerConverters.EnumEquals}, ConverterParameter=Yolo}" />
          </StackPanel>
        </DockPanel>

        <TextBox x:Name="InputBox"
                 Text="{Binding Composer.Draft, Mode=TwoWay}"
                 Watermark="Ask anything..."
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="60"
                 MaxHeight="220"
                 VerticalContentAlignment="Top"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="4"
                 FontSize="13" />
      </DockPanel>
    </Border>
  </StackPanel>
</UserControl>
