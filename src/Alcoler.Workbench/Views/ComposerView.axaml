<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Alcoler.Workbench.Converters"
             xmlns:events="using:Alcoler.Contracts.Events"
             xmlns:vm="using:Alcoler.Workbench.ViewModel"
             xmlns:local="using:Alcoler.Workbench"
             xmlns:controls="using:Alcoler.Workbench.Controls"
             x:Class="Alcoler.Workbench.Views.ComposerView"
             x:DataType="vm:IComposerHost"
             Background="{DynamicResource AlcolerBackground}">
  <UserControl.Styles>
    <Style Selector="Border.composerShell:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AlcolerBorderHover}" />
    </Style>
    <Style Selector="Border.composerShell:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource AlcolerTextSecondary}" />
    </Style>
    <Style Selector="Button.toolbarAction">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.modePicker">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.modePicker.fullAccess TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AlcolerWarning}" />
    </Style>
    <Style Selector="Button.modePicker.fullAccess controls|Icon.icon">
      <Setter Property="Stroke" Value="{DynamicResource AlcolerWarning}" />
    </Style>
    <Style Selector="Button.toolbarPicker">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="{DynamicResource AlcolerFontBase}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="UserControl.compact TextBlock.modeLabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <controls:ConversationLayout Padding="16,8,16,16">
    <StackPanel Spacing="8">
      <Border x:Name="QueueStrip" IsVisible="{Binding HasQueuedInput}"
              Background="{DynamicResource AlcolerSurface}"
              BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="1"
              CornerRadius="12" Padding="12,8" MaxHeight="96">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="4">
            <TextBlock Text="Queued messages" FontSize="{DynamicResource AlcolerFontSmall}" Foreground="{DynamicResource AlcolerTextSecondary}" />
            <ItemsControl x:Name="QueueList" ItemsSource="{Binding Queue}">
              <ItemsControl.Template>
                <ControlTemplate><ItemsPresenter /></ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="events:QueuedInput">
                  <TextBlock Text="{Binding Text}" FontSize="{DynamicResource AlcolerFontBase}" FontFamily="{DynamicResource AlcolerFontPrimary}" TextWrapping="Wrap"
                             Foreground="{DynamicResource AlcolerTextPrimary}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border x:Name="ComposerShell" Classes="composerShell"
              Background="{DynamicResource AlcolerInput}"
              BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="1"
              CornerRadius="16" Padding="12">
        <StackPanel Spacing="12">
          <Border x:Name="SkillPanel" IsVisible="False" MaxHeight="220"
                  Background="{DynamicResource AlcolerSurface}" CornerRadius="8" Padding="4">
            <ListBox x:Name="SkillSuggestions" SelectionMode="Single" MaxHeight="212">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:ComposerSkillEntry">
                  <StackPanel Spacing="2" Margin="4">
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource AlcolerFontBase}" FontFamily="{DynamicResource AlcolerFontPrimary}" />
                    <TextBlock Text="{Binding Description}" FontSize="{DynamicResource AlcolerFontSmall}" MaxWidth="560"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AlcolerTextSecondary}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <ItemsControl ItemsSource="{Binding Composer.Attachments}" IsVisible="{Binding Composer.HasAttachments}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ComposerImageAttachment">
                <Border BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,6,6">
                  <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                    <Button Classes="ghost" Padding="0" Cursor="Hand" Click="OnPreviewImageClick"
                            ToolTip.Tip="{Binding Name}" AutomationProperties.Name="Preview image">
                      <Image Source="{Binding Thumbnail}" Width="72" Height="56" Stretch="UniformToFill" />
                    </Button>
                    <Button Grid.Column="1" Classes="icon toolbarAction" VerticalAlignment="Top" Click="OnRemoveImageClick" ToolTip.Tip="Remove image">
                      <controls:Icon Classes="icon small" Data="M6 6l12 12 M18 6 6 18" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBox x:Name="InputBox" Classes="bare"
                   Text="{Binding Composer.Draft, Mode=TwoWay}"
                   Watermark="Ask anything..."
                   AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="40" MaxHeight="160" VerticalContentAlignment="Top"
                   FontSize="{DynamicResource AlcolerFontBase}" LineHeight="20" FontFamily="{DynamicResource AlcolerFontPrimary}" />

          <TextBlock Text="{Binding Composer.InputError}" IsVisible="{Binding !!Composer.InputError}"
                     Foreground="{DynamicResource AlcolerWarning}" FontSize="{DynamicResource AlcolerFontSmall}" TextWrapping="Wrap" />
          <Grid x:Name="ComposerToolbar" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6" Height="28">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
              <Button x:Name="ModeSelector" Classes="modePicker" Classes.fullAccess="{Binding Composer.IsFullAccess}"
                      ToolTip.Tip="Permissions for the next message" VerticalAlignment="Center" AutomationProperties.Name="Permissions">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <controls:Icon Classes="icon" Data="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z M9 12l2 2 4-4" />
                  <TextBlock Classes="modeLabel" Text="{Binding Composer.ModeLabel}" FontSize="{DynamicResource AlcolerFontBase}" VerticalAlignment="Center" />
                  <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconChevronDown}" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedLeft">
                    <StackPanel Spacing="8" MinWidth="220" MaxWidth="256">
                      <TextBlock Text="Permissions" FontSize="{DynamicResource AlcolerFontSmall}" Foreground="{DynamicResource AlcolerTextSecondary}" />
                      <RadioButton GroupName="ComposerMode" Content="Build" ToolTip.Tip="Ask before making changes"
                                   IsChecked="{Binding Composer.Mode, Mode=TwoWay, Converter={x:Static converters:ComposerConverters.EnumEquals}, ConverterParameter=Build}" />
                      <RadioButton GroupName="ComposerMode" Content="Edit" ToolTip.Tip="Allow file edits"
                                   IsChecked="{Binding Composer.Mode, Mode=TwoWay, Converter={x:Static converters:ComposerConverters.EnumEquals}, ConverterParameter=Edit}" />
                      <RadioButton GroupName="ComposerMode" Content="Plan" ToolTip.Tip="Plan without making changes"
                                   IsChecked="{Binding Composer.Mode, Mode=TwoWay, Converter={x:Static converters:ComposerConverters.EnumEquals}, ConverterParameter=Plan}" />
                      <RadioButton GroupName="ComposerMode" Content="Full access" ToolTip.Tip="Allow tools without approval"
                                   IsChecked="{Binding Composer.Mode, Mode=TwoWay, Converter={x:Static converters:ComposerConverters.EnumEquals}, ConverterParameter=Yolo}" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button x:Name="StatusTrigger" Classes="modePicker" Click="OnStatusClick" IsVisible="False" VerticalAlignment="Center"
                      ToolTip.Tip="Show running activities" AutomationProperties.Name="Show running activities">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <controls:Icon Classes="icon" Data="M4 4h16v16H4ZM7 8l3 3-3 3M12 15h5" />
                  <TextBlock x:Name="StatusTriggerText" FontSize="{DynamicResource AlcolerFontBase}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>

            <Button x:Name="ModelSelector" Grid.Column="3" Classes="ghost toolbarPicker"
                    MinWidth="40" MaxWidth="240" HorizontalAlignment="Right"
                    Click="OnModelPickerClick" AutomationProperties.Name="Choose model">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="ModelLabel" MaxWidth="210" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconChevronDown}" />
              </StackPanel>
              <Button.Flyout><MenuFlyout Placement="TopEdgeAlignedLeft" /></Button.Flyout>
            </Button>

            <controls:ContextUsageView x:Name="ContextUsageHost" Grid.Column="2" DataContext="{Binding ContextUsage}"
                                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button x:Name="ThoughtLevelSelector" Classes="ghost toolbarPicker" MinWidth="66" MaxWidth="112"
                      ToolTip.Tip="Reasoning effort (Ctrl+T)" IsVisible="{Binding !!ThoughtLevels.Count}" Click="OnThoughtPickerClick" AutomationProperties.Name="Reasoning effort">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <controls:Icon Classes="icon small" Data="M12 18V5 M12 5C8 0 3 4 5 8 1 10 3 15 6 15c-1 5 5 7 6 3 M12 5c4-5 9-1 7 3 4 2 2 7-1 7 1 5-5 7-6 3" />
                  <TextBlock Text="{Binding ThoughtLevel}" FontSize="{DynamicResource AlcolerFontBase}"
                             LineHeight="{DynamicResource AlcolerIconSizeSmall}" VerticalAlignment="Center" />
                  <controls:Icon x:Name="ThoughtChevron" Classes="icon small" Data="{StaticResource AlcolerIconChevronDown}" />
                </StackPanel>
                <Button.Flyout><MenuFlyout Placement="TopEdgeAlignedLeft" /></Button.Flyout>
              </Button>
              <Button x:Name="StopButton" Classes="icon toolbarAction"
                      IsVisible="{Binding Composer.ShowStop}" Click="OnStopClick" ToolTip.Tip="Stop">
                <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconSquare}"
                      Stroke="{DynamicResource AlcolerTextPrimary}" Fill="{DynamicResource AlcolerTextPrimary}" />
              </Button>
              <Button x:Name="SendButton" Classes="primary icon toolbarAction"
                      IsVisible="{Binding !Composer.ShowStop}" IsEnabled="{Binding Composer.CanSend}" Click="OnSendClick" ToolTip.Tip="{Binding Composer.SendHint}" AutomationProperties.Name="Send message">
                <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconArrowUp}" />
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </controls:ConversationLayout>
</UserControl>
