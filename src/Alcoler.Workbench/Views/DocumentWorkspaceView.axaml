<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alcoler.Workbench.ViewModel"
             xmlns:views="using:Alcoler.Workbench.Views"
             xmlns:controls="using:Alcoler.Workbench.Controls"
             x:Class="Alcoler.Workbench.Views.DocumentWorkspaceView"
             x:DataType="vm:WorkbenchViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:GitPaneViewModel"><views:GitPaneView /></DataTemplate>
    <DataTemplate DataType="vm:BrowserPaneViewModel"><views:BrowserPaneView /></DataTemplate>
    <DataTemplate DataType="vm:TerminalPaneViewModel"><views:TerminalView /></DataTemplate>
    <DataTemplate DataType="vm:TextDocumentViewModel"><views:FileDocumentView /></DataTemplate>
  </UserControl.DataTemplates>
  <UserControl.Styles>
    <Style Selector="Border.documentTab">
      <Setter Property="Background" Value="{DynamicResource AlcolerTransparent}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,0,2,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.documentTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource AlcolerHover}" />
    </Style>
    <Style Selector="Border.documentTab.active">
      <Setter Property="Background" Value="{DynamicResource AlcolerSelected}" />
    </Style>
    <Style Selector="Border.documentTab TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
    </Style>
    <Style Selector="Border.documentTab.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="Border.documentTab Button.documentClose">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.documentTab:pointerover Button.documentClose">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.documentTab:focus-within Button.documentClose">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.documentTab.active Button.documentClose">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="48,*" Background="{DynamicResource AlcolerBackground}">
    <Border x:Name="DocumentHeader" BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="0,0,0,1"
            PointerPressed="OnHeaderPointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,0,6,0" ColumnSpacing="4">
        <Button x:Name="DocumentOverviewButton" Classes="icon" ToolTip.Tip="Search tabs" AutomationProperties.Name="Search tabs"
                VerticalAlignment="Center">
          <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconSearch}" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Width="280" Spacing="8">
                <TextBox x:Name="DocumentSearch" Watermark="Search tabs" TextChanged="OnSearchChanged" FontSize="12" />
                <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="DocumentOverviewItems" ItemsSource="{Binding Documents.VisibleItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DocumentViewModel">
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="OnOverviewDocumentClick" ToolTip.Tip="{Binding Title}">
                          <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                            <controls:Icon Classes="icon small" Data="{Binding IconPath}" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <ScrollViewer x:Name="DocumentTabsScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
          <ItemsControl x:Name="DocumentTabs" ItemsSource="{Binding Documents.VisibleItems}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:DocumentTabPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentViewModel">
                <Border Classes="documentTab" Classes.active="{Binding IsActive}" Height="28" Margin="0,0,4,0"
                        Focusable="True" ToolTip.Tip="{Binding Title}" AutomationProperties.Name="{Binding Title}"
                        AutomationProperties.AutomationId="{Binding Id}"
                        PointerPressed="OnTabPointerPressed" KeyDown="OnTabKeyDown">
                  <Grid ColumnDefinitions="14,*,22" ColumnSpacing="5">
                    <controls:Icon Classes="icon small" Data="{Binding IconPath}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Classes="icon tiny documentClose" Click="OnCloseDocumentClick"
                            ToolTip.Tip="Close tab" AutomationProperties.Name="Close tab">
                      <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconX}" />
                    </Button>
                  </Grid>
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Close" Click="OnCloseDocumentClick" />
                      <MenuItem Header="Close others" Click="OnCloseOthersClick" />
                      <MenuItem Header="Close all" Click="OnCloseAllClick" />
                      <Separator />
                      <MenuItem Header="Move left" Click="OnMoveLeftClick" />
                      <MenuItem Header="Move right" Click="OnMoveRightClick" />
                    </ContextMenu>
                  </Border.ContextMenu>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button x:Name="AddDocumentButton" Classes="icon" ToolTip.Tip="New tab" AutomationProperties.Name="New tab">
            <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconPlus}" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel MinWidth="180" Spacing="2">
                  <Button Classes="ghost" Content="Changes" Click="OnOpenChangesClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                  <Button Classes="ghost" Content="Terminal" Click="OnOpenTerminalClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                  <Button Classes="ghost" Content="Browser" Click="OnOpenBrowserClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                  <Separator />
                  <Button Classes="ghost" Content="Open file..." Click="OnOpenFileClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="CollapseDocumentsButton" Classes="icon" Command="{Binding Documents.CollapseCommand}"
                  ToolTip.Tip="Collapse side panel (Ctrl+Alt+B)" AutomationProperties.Name="Collapse side panel">
            <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconPanel}" />
          </Button>
        </StackPanel>
        <Border Grid.Column="3" Width="92" />
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <StackPanel x:Name="DocumentEmptyState" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding !Documents.HasDocuments}" Margin="24">
        <controls:Icon Data="{StaticResource AlcolerIconPanel}" Width="32" Height="32" HorizontalAlignment="Center"
                       Stroke="{DynamicResource AlcolerTextTertiary}" />
        <TextBlock Text="Open a tab" FontSize="14" HorizontalAlignment="Center" />
        <TextBlock Text="Files, changes, browser, terminal and more" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{DynamicResource AlcolerTextSecondary}" />
        <Button Classes="outline" Content="Open tab" Click="OnOpenTabClick" HorizontalAlignment="Center" />
      </StackPanel>
      <ItemsControl x:Name="DocumentBodies" ItemsSource="{Binding Documents.Items}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DocumentViewModel">
            <ContentControl Content="{Binding Content}" IsVisible="{Binding IsActive}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</UserControl>
