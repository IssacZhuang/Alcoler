<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Alcoler.Workbench.Converters"
             xmlns:events="using:Alcoler.Contracts.Events"
             xmlns:vm="using:Alcoler.Workbench.ViewModel"
             x:Class="Alcoler.Workbench.Views.InteractionAreaView"
             x:DataType="vm:ConversationViewModel">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlcolerBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource AlcolerError}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas,Courier New,monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="6">
    <Border x:Name="BannerStrip"
            IsVisible="False"
            Background="{DynamicResource AlcolerError}"
            CornerRadius="6"
            Padding="8,4">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="x" Click="OnDismissBanner" FontSize="11" Padding="6,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AlcolerTextPrimary}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <ContentControl x:Name="InteractionHost" Content="{Binding PendingInteraction}" IsVisible="{Binding HasPendingInteraction}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:PendingInteractionViewModel">
          <StackPanel Spacing="6">
            <Border x:Name="PermissionCard" Classes="card" IsVisible="{Binding IsPermission}" KeyDown="OnPermissionCardKeyDown">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Permission required" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" Foreground="{DynamicResource AlcolerAccent}" />
                    <Border Classes="badge" Background="{Binding RiskLevel, Converter={x:Static converters:ComposerConverters.RiskLevelBrush}}">
                      <TextBlock Text="{Binding RiskLevel}" FontSize="11" Foreground="{DynamicResource AlcolerTextPrimary}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Reason}" Opacity="0.65" TextWrapping="Wrap" FontSize="12" />
                  <Expander Header="Input">
                    <TextBlock Classes="mono" Text="{Binding InputJson}" TextWrapping="Wrap" Opacity="0.8" />
                  </Expander>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                  <Button x:Name="DenyButton" Content="Deny" Classes="danger" MinWidth="64" Click="OnDenyClick" />
                  <Button x:Name="AllowButton" Content="Allow" MinWidth="64" Click="OnAllowClick" />
                </StackPanel>
              </Grid>
            </Border>

            <Border x:Name="QuestionCard" Classes="card" IsVisible="{Binding !IsPermission}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Prompt}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Questions}">
                  <ItemsControl.Template>
                    <ControlTemplate>
                      <ItemsPresenter />
                    </ControlTemplate>
                  </ItemsControl.Template>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="events:InteractionQuestion">
                      <StackPanel Spacing="4" Margin="0,2">
                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding Text}" Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
                        <!-- Reflection bindings: option scope needs the owning question, which compiled casts cannot express. -->
                        <ItemsControl ItemsSource="{Binding Options}" x:CompileBindings="False">
                          <ItemsControl.Template>
                            <ControlTemplate>
                              <ItemsPresenter />
                            </ControlTemplate>
                          </ItemsControl.Template>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Spacing="2">
                                <RadioButton Content="{Binding Label}"
                                             Tag="{Binding}"
                                             GroupName="{Binding $parent[ItemsControl].DataContext.Header}"
                                             IsVisible="{Binding $parent[ItemsControl].DataContext.MultiSelect, Converter={x:Static converters:ComposerConverters.Not}}"
                                             Click="OnOptionClick" />
                                <CheckBox Content="{Binding Label}"
                                          Tag="{Binding}"
                                          IsVisible="{Binding $parent[ItemsControl].DataContext.MultiSelect}"
                                          Click="OnOptionClick" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="SubmitAnswersButton"
                        Content="Submit"
                        MinWidth="64"
                        HorizontalAlignment="Right"
                        Click="OnSubmitAnswersClick">
                  <Button.IsEnabled>
                    <MultiBinding Converter="{x:Static converters:ComposerConverters.CountSatisfied}">
                      <Binding Path="SelectedAnswers.Count" />
                      <Binding Path="Questions.Count" />
                    </MultiBinding>
                  </Button.IsEnabled>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </StackPanel>
</UserControl>
