<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Alcoler.Workbench.Converters"
             xmlns:events="using:Alcoler.Contracts.Events"
             xmlns:vm="using:Alcoler.Workbench.ViewModel"
             x:Class="Alcoler.Workbench.Views.InteractionAreaView"
             x:DataType="vm:ConversationViewModel"
             Background="{DynamicResource AlcolerBackground}">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AlcolerCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlcolerBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadiusFull}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas,Courier New,monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="16,0,16,0" MaxWidth="800" HorizontalAlignment="Stretch">
    <StackPanel Spacing="8">
      <Border x:Name="BannerStrip"
              IsVisible="False"
              Background="{DynamicResource AlcolerCard}"
              BorderBrush="{DynamicResource AlcolerError}"
              BorderThickness="1"
              CornerRadius="{DynamicResource AlcolerRadiusLarge}"
              Padding="12,8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="icon tiny" Click="OnDismissBanner" ToolTip.Tip="Dismiss">
            <Path Classes="icon small" Data="{StaticResource AlcolerIconX}" />
          </Button>
          <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{DynamicResource AlcolerError}" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <ContentControl x:Name="InteractionHost" Content="{Binding PendingInteraction}" IsVisible="{Binding HasPendingInteraction}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:PendingInteractionViewModel">
            <StackPanel Spacing="8">
              <Border x:Name="PermissionCard" Classes="card" IsVisible="{Binding IsPermission}" KeyDown="OnPermissionCardKeyDown">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                      <Path Classes="icon" Data="{StaticResource AlcolerIconWrench}" HorizontalAlignment="Center"
                            Stroke="{DynamicResource AlcolerTextSecondary}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="Permission required" FontSize="13" FontWeight="Medium" />
                      <TextBlock Text="{Binding ToolName}" FontSize="12"
                                 Foreground="{DynamicResource AlcolerTextSecondary}" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="badge"
                            Background="{Binding RiskLevel, Converter={x:Static converters:ComposerConverters.RiskLevelBrush}}">
                      <TextBlock Text="{Binding RiskLevel}" FontSize="11" FontWeight="Medium"
                                 Foreground="{DynamicResource AlcolerBrandText}" />
                    </Border>
                  </Grid>

                  <StackPanel Grid.Row="1" Spacing="8">
                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource AlcolerTextSecondary}" />
                    <Expander Header="Details" FontSize="12">
                      <TextBlock Classes="mono" Text="{Binding InputJson}" TextWrapping="Wrap"
                                 Margin="0,4,0,0" />
                    </Expander>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                      <TextBlock Text="Enter to allow / Esc to deny" FontSize="11" VerticalAlignment="Center"
                                 Foreground="{DynamicResource AlcolerTextSecondary}" />
                      <Button x:Name="DenyButton" Content="Deny" Classes="outline" MinWidth="72" Height="28" Padding="12,0" Click="OnDenyClick" />
                      <Button x:Name="AllowButton" Content="Allow" Classes="primary" MinWidth="72" Height="28" Padding="12,0" Click="OnAllowClick" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <Border x:Name="QuestionCard" Classes="card" IsVisible="{Binding !IsPermission}">
                <StackPanel Spacing="10">
                  <TextBlock Text="{Binding Prompt}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Questions}">
                    <ItemsControl.Template>
                      <ControlTemplate>
                        <ItemsPresenter />
                      </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="events:InteractionQuestion">
                        <StackPanel Spacing="6" Margin="0,2">
                          <TextBlock Text="{Binding Header}" FontSize="12" FontWeight="Medium" />
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"
                                     Foreground="{DynamicResource AlcolerTextSecondary}" />
                          <TextBlock Text="Select all that apply" FontSize="11" IsVisible="{Binding MultiSelect}"
                                     Foreground="{DynamicResource AlcolerTextSecondary}" />
                          <!-- Compiled bindings cannot express the owning question from an option scope. -->
                          <ItemsControl ItemsSource="{Binding Options}" x:CompileBindings="False">
                            <ItemsControl.Template>
                              <ControlTemplate>
                                <ItemsPresenter />
                              </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Spacing="4" Margin="0,2">
                                  <RadioButton Content="{Binding Label}"
                                               Tag="{Binding}"
                                               GroupName="{Binding $parent[ItemsControl].DataContext.Header}"
                                               FontSize="13" MinHeight="32" Padding="8,4"
                                               IsVisible="{Binding $parent[ItemsControl].DataContext.MultiSelect, Converter={x:Static converters:ComposerConverters.Not}}"
                                               Click="OnOptionClick" />
                                  <CheckBox Content="{Binding Label}"
                                            Tag="{Binding}" FontSize="13" MinHeight="32" Padding="8,4"
                                            IsVisible="{Binding $parent[ItemsControl].DataContext.MultiSelect}"
                                            Click="OnOptionClick" />
                                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="32,0,8,4"
                                             FontSize="12" Foreground="{DynamicResource AlcolerTextSecondary}"
                                             IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button x:Name="SubmitAnswersButton"
                          Content="Submit"
                          Classes="primary"
                          MinWidth="72" Height="28" Padding="12,0"
                          HorizontalAlignment="Right" IsEnabled="{Binding CanSubmit}"
                          Click="OnSubmitAnswersClick" />
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </StackPanel>
  </Grid>
</UserControl>
