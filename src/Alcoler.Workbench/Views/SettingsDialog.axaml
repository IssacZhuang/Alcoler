<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Alcoler.Workbench.ViewModel"
        xmlns:controls="using:Alcoler.Workbench.Controls"
        xmlns:views="using:Alcoler.Workbench.Views"
        xmlns:workbench="using:Alcoler.Workbench"
        x:Class="Alcoler.Workbench.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="1080" Height="800" MinWidth="900" MinHeight="600"
        CanResize="True" ShowInTaskbar="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AlcolerSidebar}">
  <Window.Styles>
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
      <Setter Property="Width" Value="32" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid x:Name="SwitchSurface">
            <Border x:Name="SwitchTrack" Height="18" CornerRadius="9" Background="{DynamicResource AlcolerSurfaceHigh}" VerticalAlignment="Center" />
            <Canvas Width="28" Height="14" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center">
              <Panel x:Name="PART_SwitchKnob" Width="14" Height="14" Background="Transparent" />
              <Panel x:Name="PART_MovingKnobs" Width="14" Height="14">
                <Ellipse x:Name="SwitchThumb" Fill="{DynamicResource AlcolerTextPrimary}" />
              </Panel>
            </Canvas>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchTrack">
      <Setter Property="Background" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchThumb">
      <Setter Property="Fill" Value="{DynamicResource AlcolerBackground}" />
    </Style>
    <Style Selector="ToggleSwitch /template/ Grid#SwitchSurface">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleSwitch:focus-visible /template/ Grid#SwitchSurface">
      <Setter Property="Background" Value="{DynamicResource AlcolerHover}" />
    </Style>
    <Style Selector="ToggleSwitch:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="{DynamicResource AlcolerFontBase}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.description">
      <Setter Property="FontSize" Value="{DynamicResource AlcolerFontSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadiusLarge}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="{DynamicResource AlcolerFontBase}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadiusLarge}" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadiusLarge}" />
    </Style>
    <Style Selector="Border.sectionSpacing">
      <Setter Property="Padding" Value="0,16,0,0" />
    </Style>
    <Style Selector="RadioButton.settingsTab">
      <Setter Property="Height" Value="32" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
      <Setter Property="FontSize" Value="{DynamicResource AlcolerFontBase}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="TabSurface" Background="{DynamicResource AlcolerTransparent}"
                  CornerRadius="{DynamicResource AlcolerRadiusXLarge}" Padding="10,0">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.settingsTab:pointerover /template/ Border#TabSurface">
      <Setter Property="Background" Value="{DynamicResource AlcolerHover}" />
    </Style>
    <Style Selector="RadioButton.settingsTab:checked /template/ Border#TabSurface">
      <Setter Property="Background" Value="{DynamicResource AlcolerSelected}" />
    </Style>
    <Style Selector="RadioButton.settingsTab:focus-visible /template/ Border#TabSurface">
      <Setter Property="Background" Value="{DynamicResource AlcolerHover}" />
    </Style>
    <Style Selector="ListBox.providerList">
      <Setter Property="Background" Value="{DynamicResource AlcolerTransparent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="ListBox.providerList ListBoxItem">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadiusLarge}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="ListBox.providerList ListBoxItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="ListBox.providerList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerHover}" />
    </Style>
    <Style Selector="ListBox.providerList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerSelected}" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="264,*">
    <Grid Margin="8,16,8,16" RowDefinitions="Auto,*,Auto">
      <Button x:Name="BackButton" Classes="ghost action" Click="OnCancelClick"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="4,0,4,24">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <controls:Icon Classes="icon" Data="M19 12H5m7-7-7 7 7 7" />
          <TextBlock Text="Back to workspace" />
        </StackPanel>
      </Button>
      <StackPanel Grid.Row="1" Spacing="4">
        <TextBlock Classes="description" Text="Basics" Margin="10,0,0,4" />
        <RadioButton x:Name="AppearanceTab" Classes="settingsTab" GroupName="SettingsSection"
                     Tag="appearance" IsCheckedChanged="OnSectionChanged">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconPanel}" />
            <TextBlock Text="Appearance" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="ProvidersTab" Classes="settingsTab" GroupName="SettingsSection"
                     Tag="providers" IsCheckedChanged="OnSectionChanged">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:Icon Classes="icon" Data="M12 3 3 7.5v9L12 21l9-4.5v-9ZM3 7.5l9 4.5 9-4.5M12 12v9M7.5 5.25l9 4.5" />
            <TextBlock Text="Model providers" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="RuntimeTab" Classes="settingsTab" GroupName="SettingsSection"
                     Tag="runtime" IsCheckedChanged="OnSectionChanged" IsVisible="{Binding SupportsShellSelection}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:Icon Classes="icon" Data="M4 5h16v14H4z M7 9l3 3-3 3 M12 15h5" />
            <TextBlock Text="Runtime" />
          </StackPanel>
        </RadioButton>
        <TextBlock Classes="description" Text="Agent capabilities" Margin="10,24,0,4" />
        <RadioButton x:Name="McpTab" Classes="settingsTab" GroupName="SettingsSection"
                     Tag="mcp" IsCheckedChanged="OnSectionChanged">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconWrench}" />
            <TextBlock Text="MCP servers" />
          </StackPanel>
        </RadioButton>
      </StackPanel>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="10,0">
        <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconSettings}" />
        <TextBlock Text="Settings" FontSize="{DynamicResource AlcolerFontSmall}"
                   Foreground="{DynamicResource AlcolerTextSecondary}" />
      </StackPanel>
    </Grid>

    <Border Grid.Column="1" Margin="0,4,4,4" Background="{DynamicResource AlcolerBackground}"
            BorderThickness="0"
            CornerRadius="{DynamicResource AlcolerRadius}">
      <Grid RowDefinitions="48,*,Auto">
        <Grid Margin="24,0,12,0" ColumnDefinitions="*,Auto" Background="Transparent"
              PointerPressed="OnHeaderPointerPressed">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="description" Text="Settings" />
            <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconChevronRight}" />
            <TextBlock x:Name="SectionTitle" Text="Model providers" FontSize="{DynamicResource AlcolerFontSmall}" />
          </StackPanel>
          <Button x:Name="CloseButton" Grid.Column="1" Classes="icon" Click="OnCancelClick"
                  ToolTip.Tip="Close settings" AutomationProperties.Name="Close settings">
            <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconX}" />
          </Button>
        </Grid>

        <Grid x:Name="SettingsContent" Grid.Row="1" Margin="32,8,32,24">
          <Grid x:Name="ProvidersPanel" RowDefinitions="Auto,Auto,*">
            <TextBlock Classes="sectionTitle" Text="Model providers" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,16,0,20" ColumnSpacing="16">
              <TextBlock Classes="description" VerticalAlignment="Center"
                         Text="Configure API access and the models available in your sessions." />
              <Button x:Name="AddProviderButton" Grid.Column="1" Classes="primary action">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconPlus}" />
                  <TextBlock Text="Add provider" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel Width="280" Spacing="6">
                      <Button Classes="ghost action" Content="Custom provider" Click="OnProviderAdded" HorizontalAlignment="Stretch" />
                      <TextBlock Classes="description" Text="Provider templates" Margin="8,8,0,4" />
                      <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ProviderTemplates}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="workbench:ProviderTemplate">
                              <Button Classes="ghost action" Content="{Binding Name}" Click="OnAddTemplateClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
            <Border Grid.Row="2" BorderThickness="0"
                    Background="{DynamicResource AlcolerCard}" CornerRadius="{DynamicResource AlcolerRadiusXLarge}">
              <Grid ColumnDefinitions="224,*">
                <Border BorderThickness="0">
                  <Grid RowDefinitions="Auto,*">
                    <TextBlock Classes="description" Text="Providers" Margin="18,16,12,8" />
                    <ListBox x:Name="ProviderList" Grid.Row="1" Classes="providerList" ItemsSource="{Binding Providers}"
                             SelectedItem="{Binding SelectedProvider, Mode=TwoWay}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProviderViewModel">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <controls:Icon Classes="icon" VerticalAlignment="Center" Data="M12 3 3 7.5v9L12 21l9-4.5v-9ZM3 7.5l9 4.5 9-4.5M12 12v9" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                            <Border Grid.Column="2" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AlcolerTextSecondary}" Opacity="0.35" IsVisible="{Binding !Enabled}" ToolTip.Tip="Disabled" />
                            <Border Grid.Column="2" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AlcolerTextPrimary}" IsVisible="{Binding Enabled}" ToolTip.Tip="Enabled" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
                <Grid Grid.Column="1">
                  <StackPanel x:Name="ProviderEmptyState" Margin="24" Spacing="8"
                              VerticalAlignment="Center" IsVisible="{Binding !Providers.Count}">
                    <TextBlock Text="No providers configured" FontWeight="Medium" />
                    <TextBlock Classes="description" Text="Add a provider to configure API access and models." />
                  </StackPanel>
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !!Providers.Count}">
                    <ContentControl Content="{Binding SelectedProvider}" HorizontalContentAlignment="Stretch">
                      <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:ProviderViewModel">
                          <StackPanel Margin="20" Spacing="16">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsRenaming}" VerticalAlignment="Center">
                                <controls:Icon Classes="icon" Data="M12 3 3 7.5v9L12 21l9-4.5v-9ZM3 7.5l9 4.5 9-4.5M12 12v9" />
                                <TextBlock Text="{Binding Label}" FontSize="{DynamicResource AlcolerFontLarge}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                              </StackPanel>
                              <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="Provider name" IsVisible="{Binding IsRenaming}"
                                       LostFocus="OnProviderNameLostFocus" KeyDown="OnProviderNameKeyDown" AutomationProperties.Name="Provider name" />
                              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"
                                            ToolTip.Tip="Enable provider" AutomationProperties.Name="Enable provider" />
                              <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Provider actions" AutomationProperties.Name="Provider actions">
                                <controls:Icon Classes="icon" Fill="{DynamicResource AlcolerTextSecondary}" StrokeThickness="0" Data="M6 12a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM13 12a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM20 12a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z" />
                                <Button.Flyout>
                                  <Flyout>
                                    <StackPanel Spacing="4" MinWidth="140">
                                      <Button Classes="ghost action" Content="Rename" Click="OnRenameProviderClick" HorizontalAlignment="Stretch" />
                                      <Button Classes="ghost action" Content="Remove provider" Command="{Binding RemoveProviderCommand}" HorizontalAlignment="Stretch" Foreground="{DynamicResource AlcolerError}" />
                                    </StackPanel>
                                  </Flyout>
                                </Button.Flyout>
                              </Button>
                            </Grid>
                            <StackPanel Spacing="6">
                              <TextBlock Classes="fieldLabel" Text="Base URL" />
                              <TextBox Text="{Binding BaseUrl, Mode=TwoWay}" Watermark="https://api.example.com"
                                       AutomationProperties.Name="Base URL" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                              <TextBlock Classes="fieldLabel" Text="API format" />
                              <ComboBox ItemsSource="{Binding ApiFormats}" SelectedItem="{Binding SelectedApiFormat, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" AutomationProperties.Name="API format">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ProviderApiFormat">
                                    <TextBlock Text="{Binding Label}" FontSize="{DynamicResource AlcolerFontSmall}" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="6" IsVisible="{Binding !IsChatGptAccount}">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="fieldLabel" Text="API key" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="ghost" Content="Get API Key" Padding="0" MinHeight="20"
                                        FontSize="{DynamicResource AlcolerFontSmall}" IsVisible="{Binding HasApiKeyManagementUrl}" Click="OnGetApiKeyClick" />
                              </Grid>
                              <Grid ColumnDefinitions="*,36" ColumnSpacing="4">
                                <TextBox Text="{Binding ApiKey, Mode=TwoWay}" PasswordChar="{Binding ApiKeyPasswordChar}"
                                         Watermark="Enter API key" AutomationProperties.Name="API key" />
                                <Button Grid.Column="1" Classes="icon" Command="{Binding ToggleApiKeyVisibilityCommand}"
                                        ToolTip.Tip="{Binding ApiKeyVisibilityLabel}" AutomationProperties.Name="{Binding ApiKeyVisibilityLabel}">
                                  <Grid>
                                    <controls:Icon Classes="icon" IsVisible="{Binding !IsApiKeyVisible}" Data="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Zm13 0a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                    <controls:Icon Classes="icon" IsVisible="{Binding IsApiKeyVisible}" Data="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9 5.4A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3 3.8M6.2 6.2A19 19 0 0 0 2 12s3.5 7 10 7a11 11 0 0 0 5.8-1.8" />
                                  </Grid>
                                </Button>
                              </Grid>
                            </StackPanel>
                            <StackPanel Spacing="6" IsVisible="{Binding IsChatGptAccount}">
                              <StackPanel Spacing="6"
                                          DataContext="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).ChatGpt}">
                                <Grid ColumnDefinitions="*,Auto">
                                  <TextBlock Classes="fieldLabel" Text="ChatGPT account" VerticalAlignment="Center" />
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary action" Content="Sign in with ChatGPT" Command="{Binding SignInCommand}"
                                            IsVisible="{Binding !IsWaiting}" AutomationProperties.Name="Sign in with ChatGPT" />
                                    <Button Classes="secondary action" Content="Cancel" Command="{Binding CancelSignInCommand}"
                                            IsVisible="{Binding IsWaiting}" AutomationProperties.Name="Cancel sign-in" />
                                    <Button Classes="secondary action" Content="Sign out" Command="{Binding SignOutCommand}"
                                            IsVisible="{Binding IsSignedIn}" AutomationProperties.Name="Sign out of ChatGPT" />
                                  </StackPanel>
                                </Grid>
                                <TextBlock Classes="description"
                                           Text="Authorization opens in your browser. Models come from your ChatGPT plan; credentials stay on this machine." />
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasAccountDisplay}">
                                  <TextBlock Text="{Binding AccountDisplay}" FontWeight="Medium" VerticalAlignment="Center" />
                                  <Border BorderThickness="0" CornerRadius="4" Padding="4,1"
                                          IsVisible="{Binding AccountPlan, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding AccountPlan}" FontSize="{DynamicResource AlcolerFontSmall}" Foreground="{DynamicResource AlcolerTextSecondary}" />
                                  </Border>
                                </StackPanel>
                                <StackPanel Spacing="6" IsVisible="{Binding IsWaiting}">
                                  <TextBlock Classes="description" Text="Waiting for authorization in the browser..." />
                                  <Button Classes="ghost action" Content="Open authorization page" Command="{Binding OpenAuthorizationPageCommand}" HorizontalAlignment="Left" />
                                  <TextBox Text="{Binding AuthorizeUrl, Mode=OneWay}" IsReadOnly="True"
                                           FontFamily="{DynamicResource AlcolerFontMonospace}" AutomationProperties.Name="Authorization URL" />
                                </StackPanel>
                                <TextBlock Classes="description" Text="{Binding Message}" TextWrapping="Wrap"
                                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              </StackPanel>
                            </StackPanel>
                            <views:ProviderUsageView DataContext="{Binding Usage}" />
                            <Border Classes="sectionSpacing">
                              <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                  <TextBlock Classes="fieldLabel" Text="Models" VerticalAlignment="Center" />
                                  <Button Grid.Column="1" Classes="secondary action" Content="Add model" Click="OnAddModelClick" />
                                </Grid>
                                <TextBlock Classes="description" Text="Configure model limits and capabilities. Capabilities describe the model; they do not enable output options for every request." />
                                <TextBlock Classes="description" Text="No models configured. Add a model to get started." IsVisible="{Binding !Models.Count}" />
                                <ItemsControl ItemsSource="{Binding Models}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModelViewModel">
                                      <Border BorderThickness="0" Padding="0,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                          <StackPanel Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ModelId}" FontFamily="{DynamicResource AlcolerFontMonospace}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModelId}" AutomationProperties.Name="Model ID" />
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                              <Border BorderThickness="0" CornerRadius="4" Padding="4,1" ToolTip.Tip="{Binding ContextDescription}">
                                                <TextBlock Text="{Binding ContextBadge}" FontSize="{DynamicResource AlcolerFontSmall}" Foreground="{DynamicResource AlcolerTextSecondary}" />
                                              </Border>
                                              <controls:Icon Classes="icon small" IsVisible="{Binding EffectiveSupportsImage}" ToolTip.Tip="Image input" Data="M4 4h16v16H4Zm0 12 5-5 4 4 3-3 4 4M15 8h.01" />
                                              <controls:Icon Classes="icon small" IsVisible="{Binding EffectiveSupportsVideo}" ToolTip.Tip="Video input" Data="M3 6h12v12H3Zm12 4 6-4v12l-6-4" />
                                              <controls:Icon Classes="icon small" IsVisible="{Binding EffectiveSupportsPdf}" ToolTip.Tip="PDF input" Data="M6 3h8l4 4v14H6Zm8 0v5h4M9 12h6M9 16h6" />
                                              <controls:Icon Classes="icon small" IsVisible="{Binding EffectiveSupportsJsonSchemaOutput}" ToolTip.Tip="Structured output capability" Data="M8 3H5v6l-2 3 2 3v6h3M16 3h3v6l2 3-2 3v6h-3" />
                                              <controls:Icon Classes="icon small" IsVisible="{Binding EffectiveSupportsNativeWebSearch}" ToolTip.Tip="Native web search" Data="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM3 12h18M12 3c-5 5-5 13 0 18 5-5 5-13 0-18" />
                                              <controls:Icon Classes="icon small" IsVisible="{Binding EffectiveSupportsMidConversationSystem}" ToolTip.Tip="System messages in conversation" Data="M4 4h16v12H9l-5 4Zm4 4h8M8 12h5" />
                                              <controls:Icon Classes="icon small" IsVisible="{Binding HasReasoning}" ToolTip.Tip="Reasoning levels" Data="M9 18h6M9 21h6M8 15c-5-4-3-12 4-12s9 8 4 12l-1 3H9Z" />
                                            </StackPanel>
                                          </StackPanel>
                                          <Button Grid.Column="1" Classes="icon" Click="OnEditModelClick" VerticalAlignment="Center" ToolTip.Tip="Edit model configuration" AutomationProperties.Name="Edit model configuration">
                                            <controls:Icon Classes="icon small" Data="m16 3 5 5-12 12H4v-5Zm-2 2 5 5" />
                                          </Button>
                                          <Button Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}" VerticalAlignment="Center" ToolTip.Tip="Remove model" AutomationProperties.Name="Remove model">
                                            <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconX}" />
                                          </Button>
                                          <ToggleSwitch Grid.Column="3" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" ToolTip.Tip="Enable model" AutomationProperties.Name="Enable model" />
                                        </Grid>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                      </ContentControl.ContentTemplate>
                    </ContentControl>
                  </ScrollViewer>
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <ScrollViewer x:Name="McpPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="20">
              <TextBlock Classes="sectionTitle" Text="MCP servers" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Classes="description" Text="Connect local tools through Model Context Protocol servers." VerticalAlignment="Center" />
                <Button x:Name="AddServerButton" Grid.Column="1" Classes="secondary action" Command="{Binding AddServerCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconPlus}" />
                    <TextBlock Text="Add server" />
                  </StackPanel>
                </Button>
              </Grid>
              <Border IsVisible="{Binding !McpServers.Count}" BorderThickness="0"
                      Background="{DynamicResource AlcolerCard}" CornerRadius="{DynamicResource AlcolerRadiusXLarge}" Padding="24">
                <StackPanel Spacing="8">
                  <TextBlock Text="No MCP servers configured" FontWeight="Medium" />
                  <TextBlock Classes="description" Text="Add a server and configure its command, arguments, and environment." />
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding McpServers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:McpServerViewModel">
                    <Border Background="{DynamicResource AlcolerCard}" BorderThickness="0"
                            CornerRadius="{DynamicResource AlcolerRadiusXLarge}" Padding="20" Margin="0,0,0,16">
                      <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="MCP server" FontSize="{DynamicResource AlcolerFontLarge}" FontWeight="Medium" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Classes="ghost action" Content="Remove" Foreground="{DynamicResource AlcolerError}"
                                  Command="{Binding RemoveServerCommand}" />
                        </Grid>
                        <Border Classes="sectionSpacing">
                          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel Spacing="6">
                              <TextBlock Classes="fieldLabel" Text="Name" />
                              <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="filesystem" AutomationProperties.Name="Server name" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                              <TextBlock Classes="fieldLabel" Text="Command" />
                              <TextBox Text="{Binding Command, Mode=TwoWay}" Watermark="npx" AutomationProperties.Name="Server command" />
                            </StackPanel>
                          </Grid>
                        </Border>
                        <StackPanel Spacing="6">
                          <TextBlock Classes="fieldLabel" Text="Arguments" />
                          <TextBox Text="{Binding ArgsLine, Mode=TwoWay}" Watermark="-y @scope/server --flag value" AutomationProperties.Name="Server arguments" />
                        </StackPanel>
                        <Border Classes="sectionSpacing">
                          <StackPanel Spacing="6">
                            <TextBlock Classes="fieldLabel" Text="Environment variables" />
                            <TextBlock Classes="description" Text="One KEY=VALUE pair per line." />
                            <TextBox Text="{Binding EnvText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="88" MaxHeight="180" Watermark="NODE_ENV=production" AutomationProperties.Name="Server environment" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="RuntimePanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24">
              <TextBlock Classes="sectionTitle" Text="Runtime" />
              <Border Background="{DynamicResource AlcolerCard}" BorderThickness="0"
                      CornerRadius="{DynamicResource AlcolerRadiusXLarge}" Padding="16">
                <Grid ColumnDefinitions="*,224" ColumnSpacing="16">
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="fieldLabel" Text="Integrated terminal shell" />
                    <TextBlock Classes="description"
                               Text="Applies to new sessions only. On Windows, Bash uses this shell. Auto prefers Git Bash and falls back to cmd.exe." />
                  </StackPanel>
                  <ComboBox x:Name="ShellPicker" Grid.Column="1" ItemsSource="{Binding ShellChoices}"
                            SelectedItem="{Binding SelectedShell, Mode=TwoWay}" HorizontalAlignment="Stretch"
                            VerticalAlignment="Center" AutomationProperties.Name="Integrated terminal shell">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ShellChoice">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Environment.FileName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="AppearancePanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24">
              <TextBlock Classes="sectionTitle" Text="Appearance" />
              <StackPanel Spacing="12">
                <TextBlock Text="Interface" FontSize="{DynamicResource AlcolerFontLarge}" FontWeight="Medium" />
                <Border Background="{DynamicResource AlcolerCard}" BorderThickness="0"
                        CornerRadius="{DynamicResource AlcolerRadiusXLarge}" Padding="16">
                  <Grid ColumnDefinitions="*,192" ColumnSpacing="16">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                      <TextBlock Classes="fieldLabel" Text="Theme" />
                      <TextBlock Classes="description" Text="Choose the workbench color scheme." />
                    </StackPanel>
                    <ComboBox x:Name="ThemePicker" Grid.Column="1" ItemsSource="{Binding ThemeChoices}"
                              SelectedItem="{Binding Theme, Mode=TwoWay}" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" AutomationProperties.Name="Theme" />
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" BorderThickness="0" Padding="24,16">
          <StackPanel Spacing="12">
            <ScrollViewer IsVisible="{Binding HasError}" MaxHeight="84" HorizontalScrollBarVisibility="Disabled">
              <TextBlock x:Name="SaveError" Text="{Binding Error}" FontSize="{DynamicResource AlcolerFontSmall}" TextWrapping="Wrap"
                         Foreground="{DynamicResource AlcolerError}" IsVisible="{Binding HasError}" />
            </ScrollViewer>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <TextBlock Classes="description" Text="Changes apply when you save." VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CancelButton" Classes="secondary action" Content="Cancel" Click="OnCancelClick" IsCancel="True" />
                <Button x:Name="SaveButton" Classes="primary action" Content="Save changes" Click="OnSaveClick" IsDefault="True" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
