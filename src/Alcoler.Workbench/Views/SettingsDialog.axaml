<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Alcoler.Workbench.ViewModel"
        x:Class="Alcoler.Workbench.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="860" Height="600" MinWidth="720" MinHeight="480"
        CanResize="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AlcolerBackground}">
  <Window.Styles>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource AlcolerTransparent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Background" Value="{DynamicResource AlcolerTransparent}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadius}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerHover}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="52,*,60">
    <Border Grid.Row="0" BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="0,0,0,1"
            Padding="20,0,12,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Settings" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="icon" Click="OnCancelClick" ToolTip.Tip="Close">
          <Path Classes="icon" Data="{StaticResource AlcolerIconX}" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="188,*" Margin="20,16,20,12">
      <ListBox x:Name="SectionList" Grid.Column="0" Margin="0,0,20,0"
               SelectionChanged="OnSectionChanged">
        <ListBoxItem Content="Providers" />
        <ListBoxItem Content="MCP servers" />
        <ListBoxItem Content="Appearance" />
      </ListBox>

      <Grid Grid.Column="1">
        <ScrollViewer x:Name="ProvidersPanel" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">
            <ItemsControl ItemsSource="{Binding Providers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProviderViewModel">
                  <Border Background="{DynamicResource AlcolerCard}"
                          BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="1"
                          CornerRadius="{DynamicResource AlcolerRadiusXLarge}" Padding="14" Margin="0,0,0,10">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Provider" FontSize="13" FontWeight="Medium"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost" Content="Remove" FontSize="11"
                                Foreground="{DynamicResource AlcolerError}"
                                Command="{Binding RemoveProviderCommand}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="4">
                          <TextBlock Classes="fieldLabel" Text="Kind" />
                          <TextBox Text="{Binding Kind, Mode=TwoWay}" Watermark="anthropic or openai-compatible" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Classes="fieldLabel" Text="Base URL" />
                          <TextBox Text="{Binding BaseUrl, Mode=TwoWay}" Watermark="https://api.example.com" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Spacing="4">
                        <TextBlock Classes="fieldLabel" Text="API key" />
                        <TextBox Text="{Binding ApiKey, Mode=TwoWay}" Watermark="sk-..." />
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <TextBlock Classes="fieldLabel" Text="Models" />
                        <ItemsControl ItemsSource="{Binding Models}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModelViewModel">
                              <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="6" Margin="0,2">
                                <TextBox Grid.Column="0"
                                         Text="{Binding ModelId, Mode=TwoWay}" Watermark="model id" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding ContextWindowTokens, Mode=TwoWay}" Watermark="Context tokens" />
                                <Button Grid.Column="2" Classes="ghost" Content="Remove" FontSize="11"
                                        Foreground="{DynamicResource AlcolerTextTertiary}"
                                        Command="{Binding RemoveCommand}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="ghost primaryText" FontSize="12" HorizontalAlignment="Left"
                                Command="{Binding AddModelCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <Path Classes="icon small" Data="{StaticResource AlcolerIconPlus}" />
                            <TextBlock Text="Add model" FontSize="12" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="outline" HorizontalAlignment="Left" Command="{Binding AddProviderCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon small" Data="{StaticResource AlcolerIconPlus}" />
                <TextBlock Text="Add provider" FontSize="12" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="McpPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">
            <ItemsControl ItemsSource="{Binding McpServers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:McpServerViewModel">
                  <Border Background="{DynamicResource AlcolerCard}"
                          BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="1"
                          CornerRadius="{DynamicResource AlcolerRadiusXLarge}" Padding="14" Margin="0,0,0,10">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="MCP server" FontSize="13" FontWeight="Medium"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost" Content="Remove" FontSize="11"
                                Foreground="{DynamicResource AlcolerError}"
                                Command="{Binding RemoveServerCommand}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="4">
                          <TextBlock Classes="fieldLabel" Text="Name" />
                          <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="filesystem" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Classes="fieldLabel" Text="Command" />
                          <TextBox Text="{Binding Command, Mode=TwoWay}" Watermark="npx" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Spacing="4">
                        <TextBlock Classes="fieldLabel" Text="Arguments" />
                        <TextBox Text="{Binding ArgsLine, Mode=TwoWay}" Watermark="-y @scope/server --flag value" />
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <TextBlock Classes="fieldLabel" Text="Environment (KEY=VALUE per line)" />
                        <TextBox Text="{Binding EnvText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="56" MaxHeight="120" Watermark="NODE_ENV=production" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="outline" HorizontalAlignment="Left" Command="{Binding AddServerCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon small" Data="{StaticResource AlcolerIconPlus}" />
                <TextBlock Text="Add server" FontSize="12" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="AppearancePanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <Border Background="{DynamicResource AlcolerCard}"
                  BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="1"
                  CornerRadius="{DynamicResource AlcolerRadiusXLarge}" Padding="14"
                  HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel Spacing="6">
              <TextBlock Text="Theme" FontSize="13" FontWeight="Medium" />
              <TextBlock Text="Choose the workbench color scheme." FontSize="12"
                         Foreground="{DynamicResource AlcolerTextSecondary}" />
              <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme, Mode=TwoWay}"
                        HorizontalAlignment="Left" MinWidth="160" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Row="2" BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="0,1,0,0"
            Padding="20,0,16,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Error}" FontSize="11" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{DynamicResource AlcolerError}" IsVisible="{Binding HasError}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="outline" Content="Cancel" Click="OnCancelClick" IsCancel="True" />
          <Button Classes="primary" Content="Save" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
