<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Alcoler.Workbench.Views"
             xmlns:vm="using:Alcoler.Workbench.ViewModel"
             x:Class="Alcoler.Workbench.Views.TerminalView"
             x:DataType="vm:TerminalPaneViewModel">
  <DockPanel Background="{DynamicResource AlcolerTerminalBackground}">
    <Border DockPanel.Dock="Top" Height="34"
            BorderBrush="{DynamicResource AlcolerBorder}"
            BorderThickness="0,0,0,1"
            Padding="12,0,8,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="icon tiny" Click="OnClearClick" ToolTip.Tip="Clear terminal output">
            <Path Classes="icon small" Data="{StaticResource AlcolerIconArchive}" />
          </Button>
          <Button Content="Start" Classes="ghost" FontSize="11" Padding="8,3"
                  IsVisible="{Binding !IsConnected}" Click="OnStartClick"
                  ToolTip.Tip="Start a shell in the workspace" />
          <Button x:Name="StopButton" Classes="icon tiny" IsVisible="{Binding IsConnected}"
                  Click="OnStopClick" ToolTip.Tip="Terminate the shell">
            <Path Classes="icon small" Data="{StaticResource AlcolerIconSquare}"
                  Stroke="{DynamicResource AlcolerError}" Fill="{DynamicResource AlcolerTransparent}" />
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Path Classes="icon small" Data="{StaticResource AlcolerIconTerminal}" />
          <TextBlock Text="Terminal" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
          <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                   Fill="{DynamicResource AlcolerSuccess}" IsVisible="{Binding IsConnected}" />
          <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                   Fill="{DynamicResource AlcolerTextTertiary}" IsVisible="{Binding !IsConnected}" />
          <TextBlock Text="{Binding StartedFrom}" FontSize="11"
                     Foreground="{DynamicResource AlcolerTextTertiary}"
                     TextTrimming="CharacterEllipsis" MaxWidth="320" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Background="{DynamicResource AlcolerTerminalBackground}" Padding="10,6">
      <v:TerminalSurface x:Name="Surface" ClipToBounds="True" />
    </Border>
  </DockPanel>
</UserControl>
