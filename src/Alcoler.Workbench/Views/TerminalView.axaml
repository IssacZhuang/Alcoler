<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Alcoler.Workbench.Views"
             xmlns:vm="using:Alcoler.Workbench.ViewModel"
             x:Class="Alcoler.Workbench.Views.TerminalView"
             x:DataType="vm:TerminalPaneViewModel">
  <UserControl.Styles>
    <Style Selector="Button.tiny">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource AlcolerSurface}"
            BorderBrush="{DynamicResource AlcolerBorder}"
            BorderThickness="1,1,1,0"
            CornerRadius="6,6,0,0"
            Padding="8,4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Content="Clear" Classes="tiny" Click="OnClearClick" ToolTip.Tip="Clear terminal output" />
          <Button Content="Start" Classes="tiny" IsVisible="{Binding !IsConnected}" Click="OnStartClick" ToolTip.Tip="Start a shell in the workspace" />
          <Button x:Name="StopButton" Content="Stop" Classes="tiny" IsVisible="{Binding IsConnected}" Click="OnStopClick" ToolTip.Tip="Terminate the shell" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Terminal" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StartedFrom}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock Text="connected" FontSize="11" Foreground="{DynamicResource AlcolerSuccess}" IsVisible="{Binding IsConnected}" VerticalAlignment="Center" />
          <TextBlock Text="offline" FontSize="11" Opacity="0.55" IsVisible="{Binding !IsConnected}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Background="{DynamicResource AlcolerBackground}"
            BorderBrush="{DynamicResource AlcolerBorder}"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,6,6"
            Padding="4">
      <v:TerminalSurface x:Name="Surface" ClipToBounds="True" />
    </Border>
  </DockPanel>
</UserControl>
