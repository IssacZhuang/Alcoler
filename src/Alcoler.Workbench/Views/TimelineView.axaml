<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Alcoler.Workbench.Converters"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:vm="using:Alcoler.Workbench.ViewModel"
             x:Class="Alcoler.Workbench.Views.TimelineView"
             x:DataType="vm:ConversationViewModel">
  <UserControl.Styles>
    <Style Selector="Border.workingDot">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Height" Value="6"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Background" Value="{DynamicResource AlcolerBrand}"/>
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2"/></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Rectangle.streamingCaret">
      <Setter Property="Width" Value="2"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Fill" Value="{DynamicResource AlcolerTextPrimary}"/>
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.05"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas, JetBrains Mono"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}"/>
    </Style>
    <Style Selector="Border.monoPane">
      <Setter Property="Background" Value="{DynamicResource AlcolerBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AlcolerBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadius}"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="Border.terminalPane">
      <Setter Property="Background" Value="{DynamicResource AlcolerTerminalBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AlcolerBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadius}"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="Border.terminalPane SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTerminalForeground}"/>
    </Style>
    <Style Selector="Border.paneCaption">
      <Setter Property="Margin" Value="1,0,0,2"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextTertiary}"/>
    </Style>
    <Style Selector="Button.toolRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadius}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Expander.thinkingBlock">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Expander.thinkingBlock SelectableTextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}"/>
    </Style>
  </UserControl.Styles>

  <Panel>
    <ScrollViewer x:Name="TimelineScroll" Padding="20,24,20,24" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Items}" Background="Transparent"
                    MaxWidth="896" HorizontalAlignment="Stretch">        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.DataTemplates>

          <DataTemplate x:DataType="vm:UserMessageItemViewModel">
            <Border Classes="userRow" Margin="0,4,0,12" CornerRadius="12,12,4,12"
                    MaxWidth="512" HorizontalAlignment="Right" Padding="14,10"
                    BorderThickness="1"
                    Background="{DynamicResource AlcolerSurface}"
                    BorderBrush="{DynamicResource AlcolerBorder}">
              <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                                   Foreground="{DynamicResource AlcolerTextPrimary}"/>
            </Border>
          </DataTemplate>

          <DataTemplate x:DataType="vm:AssistantMessageItemViewModel">
            <StackPanel Margin="0,0,0,16" Spacing="8" MinWidth="0">
              <Expander Classes="thinkingBlock" IsExpanded="False"
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding ReasoningBlocks, Converter={x:Static conv:TimelineConverters.NonEmpty}}">
                <Expander.Header>
                  <TextBlock Text="Thinking" FontSize="12" Foreground="{DynamicResource AlcolerTextSecondary}"/>
                </Expander.Header>
                <SelectableTextBlock Margin="0,2,0,0" TextWrapping="Wrap" Opacity="0.8"
                                     FontSize="12"
                                     Foreground="{DynamicResource AlcolerTextSecondary}"
                                     Text="{Binding ReasoningBlocks, Converter={x:Static conv:TimelineConverters.JoinLines}}"/>
              </Expander>
              <md:MarkdownScrollViewer Markdown="{Binding MarkdownText}" SelectionEnabled="True" />
              <Rectangle Classes="streamingCaret" HorizontalAlignment="Left" IsVisible="{Binding IsStreaming}"/>
            </StackPanel>
          </DataTemplate>

          <DataTemplate x:DataType="vm:ToolCallItemViewModel">
            <Button Classes="toolRow" Margin="0,1" Click="OnToolRowClick">
              <StackPanel Spacing="2" MinWidth="0">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Width="14" TextAlignment="Center" FontSize="12"
                             VerticalAlignment="Center"
                             Text="{Binding Status, Converter={x:Static conv:TimelineConverters.StatusGlyph}}"
                             Foreground="{Binding Status, Converter={x:Static conv:TimelineConverters.StatusBrush}}"/>
                  <TextBlock Grid.Column="1" Text="{Binding ToolName}" FontSize="12" FontWeight="Medium"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AlcolerTextSecondary}"/>
                  <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{Binding Status, Converter={x:Static conv:TimelineConverters.StatusBrush}}"/>
                  <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="11"
                             VerticalAlignment="Center"
                             Classes="caption"
                             IsVisible="{Binding DurationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <Path Grid.Column="5" Classes="icon small" Data="{StaticResource AlcolerIconChevronRight}"
                        IsVisible="{Binding !IsExpanded}"
                        Stroke="{DynamicResource AlcolerTextTertiary}"/>
                  <Path Grid.Column="5" Classes="icon small" Data="{StaticResource AlcolerIconChevronDown}"
                        IsVisible="{Binding IsExpanded}"
                        Stroke="{DynamicResource AlcolerTextTertiary}"/>
                </Grid>

                <Border Margin="22,6,0,2" Padding="10,8"
                        CornerRadius="{DynamicResource AlcolerRadius}"
                        Background="{DynamicResource AlcolerBackground}"
                        BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="1"
                        IsVisible="{Binding IsExpanded}">
                  <StackPanel Spacing="8" MinWidth="0">
                    <StackPanel Spacing="4" IsVisible="{Binding InputJson, Converter={x:Static conv:TimelineConverters.NonEmpty}}">
                      <TextBlock Classes="caption paneCaption" Text="Input"/>
                      <Border Classes="monoPane">
                        <ScrollViewer MaxHeight="300">
                          <SelectableTextBlock Classes="mono" Text="{Binding InputJson}"/>
                        </ScrollViewer>
                      </Border>
                    </StackPanel>

                    <StackPanel Spacing="4"
                                IsVisible="{Binding OutputText, Converter={x:Static conv:TimelineConverters.NonEmpty}}">
                      <TextBlock Classes="caption paneCaption" Text="Output"/>
                      <Border Classes="terminalPane"
                              IsVisible="{Binding ToolName, Converter={x:Static conv:TimelineConverters.TerminalTool}}">
                        <ScrollViewer MaxHeight="300">
                          <SelectableTextBlock Classes="mono" Text="{Binding OutputText}"/>
                        </ScrollViewer>
                      </Border>
                      <Border Classes="monoPane"
                              IsVisible="{Binding ToolName, Converter={x:Static conv:TimelineConverters.TerminalTool}, ConverterParameter=invert}">
                        <ScrollViewer MaxHeight="300">
                          <SelectableTextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding OutputText}"/>
                        </ScrollViewer>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Button>
          </DataTemplate>

          <DataTemplate x:DataType="vm:SystemNoticeItemViewModel">
            <Border Classes="noticeRow" Margin="0,6" HorizontalAlignment="Center"
                    CornerRadius="{DynamicResource AlcolerRadiusFull}"
                    Background="{DynamicResource AlcolerSurface}" Padding="10,3">
              <StackPanel Orientation="Horizontal" Spacing="0"
                          TextBlock.Foreground="{DynamicResource AlcolerTextTertiary}">
                <TextBlock FontSize="11" Text="{Binding Kind}"/>
                <TextBlock FontSize="11" Text=": "/>
                <TextBlock FontSize="11" Text="{Binding Text}"/>
              </StackPanel>
            </Border>
          </DataTemplate>

        </ItemsControl.DataTemplates>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                IsVisible="{Binding Items.Count, Converter={StaticResource AlcolerZeroToVisible}}">
      <TextBlock Text="What can I help you with?" FontSize="20" FontWeight="Medium"
                 HorizontalAlignment="Center" />
      <TextBlock Text="Ask a question, plan a change, or describe a task."
                 FontSize="13" HorizontalAlignment="Center"
                 Foreground="{DynamicResource AlcolerTextSecondary}" />
    </StackPanel>

    <Border Classes="workingBar" IsHitTestVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="0,0,0,10" Padding="10,5" CornerRadius="{DynamicResource AlcolerRadiusFull}"
            BorderThickness="1"
            Background="{DynamicResource AlcolerCard}"
            BorderBrush="{DynamicResource AlcolerBorder}"
            IsVisible="{Binding Composer.IsTurnActive}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Classes="workingDot"/>
        <TextBlock Text="{Binding PhaseText}" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource AlcolerTextSecondary}"/>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
