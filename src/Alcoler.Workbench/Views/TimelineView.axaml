<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Alcoler.Workbench.Converters"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:vm="using:Alcoler.Workbench.ViewModel"
             x:Class="Alcoler.Workbench.Views.TimelineView"
             x:DataType="vm:ConversationViewModel">
  <UserControl.Styles>
    <Style Selector="Border.workingDot">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Height" Value="6"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Background" Value="{DynamicResource AlcolerAccent}"/>
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2"/></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Rectangle.streamingCaret">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Height" Value="15"/>
      <Setter Property="Fill" Value="{DynamicResource AlcolerAccent}"/>
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.05"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas, JetBrains Mono"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style Selector="Border.monoPane">
      <Setter Property="Background" Value="{DynamicResource AlcolerBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AlcolerBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style Selector="Border.terminalPane">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AlcolerBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style Selector="Border.terminalPane SelectableTextBlock">
      <Setter Property="Foreground" Value="#D6D6D6"/>
    </Style>
    <Style Selector="Border.paneCaption">
      <Setter Property="Margin" Value="1,0,0,2"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}"/>
    </Style>
  </UserControl.Styles>

  <Panel>
    <ScrollViewer x:Name="TimelineScroll" Padding="20,10,20,16">
      <ItemsControl ItemsSource="{Binding Items}" Background="Transparent">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.DataTemplates>

          <DataTemplate x:DataType="vm:UserMessageItemViewModel">
            <Border Classes="userRow" Margin="0,5" CornerRadius="4" BorderThickness="1"
                    Background="{DynamicResource AlcolerSurface}"
                    BorderBrush="{DynamicResource AlcolerBorder}">
              <Grid ColumnDefinitions="3,*">
                <Rectangle Grid.Column="0" Fill="{DynamicResource AlcolerAccent}"/>
                <SelectableTextBlock Grid.Column="1" Margin="10,6,8,6" Text="{Binding Text}" TextWrapping="Wrap"
                                     Foreground="{DynamicResource AlcolerTextPrimary}"/>
              </Grid>
            </Border>
          </DataTemplate>

          <DataTemplate x:DataType="vm:AssistantMessageItemViewModel">
            <StackPanel Margin="0,5" Spacing="6" MinWidth="0">
              <Expander Classes="thinkingBlock" IsExpanded="False"
                        IsVisible="{Binding ReasoningBlocks, Converter={x:Static conv:TimelineConverters.NonEmpty}}">
                <Expander.Header>
                  <TextBlock Text="Thinking" FontSize="12" Foreground="{DynamicResource AlcolerTextSecondary}"/>
                </Expander.Header>
                <SelectableTextBlock Margin="0,2,0,0" TextWrapping="Wrap" Opacity="0.75"
                                     Foreground="{DynamicResource AlcolerTextSecondary}"
                                     Text="{Binding ReasoningBlocks, Converter={x:Static conv:TimelineConverters.JoinLines}}"/>
              </Expander>
              <md:MarkdownScrollViewer Markdown="{Binding MarkdownText}" SelectionEnabled="True"/>
              <Rectangle Classes="streamingCaret" IsVisible="{Binding IsStreaming}"/>
            </StackPanel>
          </DataTemplate>

          <DataTemplate x:DataType="vm:ToolCallItemViewModel">
            <Button Classes="toolRow" Margin="0,4" Click="OnToolRowClick" CornerRadius="4" Padding="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{Binding IsError, Converter={x:Static conv:TimelineConverters.ToolRowBorder}}">
              <Button.Styles>
                <Style Selector="Button.toolRow:pointerover">
                  <Setter Property="Background" Value="{DynamicResource AlcolerSurface}"/>
                </Style>
              </Button.Styles>
              <Border Padding="10,7" MinWidth="0">
                <StackPanel Spacing="6" MinWidth="0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Width="16" TextAlignment="Center" FontSize="12" VerticalAlignment="Center"
                               Text="{Binding Status, Converter={x:Static conv:TimelineConverters.StatusGlyph}}"
                               Foreground="{Binding Status, Converter={x:Static conv:TimelineConverters.StatusBrush}}"/>
                    <TextBlock Text="{Binding ToolName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource AlcolerTextPrimary}"/>
                    <Border Classes="statusChip" CornerRadius="8" Padding="8,1" BorderThickness="1" VerticalAlignment="Center"
                            BorderBrush="{Binding Status, Converter={x:Static conv:TimelineConverters.StatusBrush}}">
                      <TextBlock Text="{Binding StatusText}" FontSize="11"
                                 Foreground="{Binding Status, Converter={x:Static conv:TimelineConverters.StatusBrush}}"/>
                    </Border>
                    <TextBlock Text="{Binding DurationText}" FontSize="11" VerticalAlignment="Center"
                               Classes="caption"
                               Foreground="{DynamicResource AlcolerTextSecondary}"
                               IsVisible="{Binding DurationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>

                  <StackPanel Spacing="6" Margin="0,2,0,0" MinWidth="0" IsVisible="{Binding IsExpanded}">
                    <StackPanel Spacing="6" IsVisible="{Binding InputJson, Converter={x:Static conv:TimelineConverters.NonEmpty}}">
                      <TextBlock Classes="caption paneCaption" Text="Input"/>
                      <Border Classes="monoPane">
                        <ScrollViewer MaxHeight="300">
                          <SelectableTextBlock Classes="mono" Text="{Binding InputJson}"/>
                        </ScrollViewer>
                      </Border>
                    </StackPanel>

                    <StackPanel Spacing="6"
                                IsVisible="{Binding OutputText, Converter={x:Static conv:TimelineConverters.NonEmpty}}">
                      <TextBlock Classes="caption paneCaption" Text="Output"/>
                      <Border Classes="terminalPane"
                              IsVisible="{Binding ToolName, Converter={x:Static conv:TimelineConverters.TerminalTool}}">
                        <ScrollViewer MaxHeight="300">
                          <SelectableTextBlock Classes="mono" Text="{Binding OutputText}"/>
                        </ScrollViewer>
                      </Border>
                      <Border Classes="monoPane"
                              IsVisible="{Binding ToolName, Converter={x:Static conv:TimelineConverters.TerminalTool}, ConverterParameter=invert}">
                        <ScrollViewer MaxHeight="300">
                          <SelectableTextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding OutputText}"/>
                        </ScrollViewer>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Button>
          </DataTemplate>

          <DataTemplate x:DataType="vm:SystemNoticeItemViewModel">
            <StackPanel Classes="noticeRow" Margin="0,5" Orientation="Horizontal" Spacing="0"
                        HorizontalAlignment="Center" TextBlock.Foreground="{DynamicResource AlcolerTextSecondary}">
              <TextBlock FontSize="11" Text="{Binding Kind}"/>
              <TextBlock FontSize="11" Text=": "/>
              <TextBlock FontSize="11" Text="{Binding Text}"/>
            </StackPanel>
          </DataTemplate>

        </ItemsControl.DataTemplates>
      </ItemsControl>
    </ScrollViewer>

    <Border Classes="workingBar" IsHitTestVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="0,0,0,6" Padding="10,4" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource AlcolerSurface}"
            BorderBrush="{DynamicResource AlcolerBorder}"
            IsVisible="{Binding Composer.IsTurnActive}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Classes="workingDot"/>
        <TextBlock Text="{Binding PhaseText}" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource AlcolerTextSecondary}"/>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
