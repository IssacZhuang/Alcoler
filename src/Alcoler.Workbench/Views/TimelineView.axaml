<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Alcoler.Workbench.Converters"
             xmlns:vm="using:Alcoler.Workbench.ViewModel"
             xmlns:parts="using:Alcoler.Contracts.Conversation"
             xmlns:controls="using:Alcoler.Workbench.Controls"
             xmlns:views="using:Alcoler.Workbench.Views"
             x:Class="Alcoler.Workbench.Views.TimelineView"
             x:Name="TimelineRoot"
             x:DataType="vm:ConversationViewModel"
             Background="{DynamicResource AlcolerBackground}">
  <UserControl.Resources>
    <views:ConversationIconConverter x:Key="ConversationIcon" />
    <ControlTheme x:Key="ConversationScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <Border x:Name="ThumbSurface" Margin="3,0" CornerRadius="999"
                    Background="{DynamicResource AlcolerTextTertiary}" Opacity="0.55" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#ThumbSurface">
        <Setter Property="Opacity" Value="0.8" />
      </Style>
      <Style Selector="^:pressed /template/ Border#ThumbSurface">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="ConversationScrollPage" TargetType="RepeatButton">
      <Setter Property="Template">
        <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ConversationScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="14" />
      <Setter Property="MinWidth" Value="14" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_PageUpButton" Focusable="False" Theme="{StaticResource ConversationScrollPage}" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_PageDownButton" Focusable="False" Theme="{StaticResource ConversationScrollPage}" />
            </Track.IncreaseButton>
            <controls:ConversationScrollThumb MinHeight="32" Theme="{StaticResource ConversationScrollThumb}" />
          </Track>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="ScrollViewer#TimelineScroll /template/ ScrollBar#PART_VerticalScrollBar">
      <Setter Property="Theme" Value="{StaticResource ConversationScrollBar}" />
    </Style>
    <Style Selector="Border.workingDot">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="5" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{DynamicResource AlcolerAccent}" />
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Border.workingBar.running Border.workingDot.first">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.4" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
          <KeyFrame Cue="20%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="-3" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.4" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.4" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.workingBar.running Border.workingDot.second">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.4" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
          <KeyFrame Cue="20%"><Setter Property="Opacity" Value="0.4" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
          <KeyFrame Cue="40%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="-3" /></KeyFrame>
          <KeyFrame Cue="70%"><Setter Property="Opacity" Value="0.4" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.4" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.workingBar.running Border.workingDot.third">
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.4" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
          <KeyFrame Cue="40%"><Setter Property="Opacity" Value="0.4" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
          <KeyFrame Cue="60%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="-3" /></KeyFrame>
          <KeyFrame Cue="90%"><Setter Property="Opacity" Value="0.4" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.4" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Rectangle.streamingCaret">
      <Setter Property="Width" Value="2" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Fill" Value="{DynamicResource AlcolerTextPrimary}" />
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.05" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="ItemsControl.wideUserMessages Border.userRow">
      <Setter Property="MaxWidth" Value="576" />
    </Style>
    <Style Selector="SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="{DynamicResource AlcolerFontMonospace}" />
      <Setter Property="FontSize" Value="{DynamicResource AlcolerFontBase}" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="Border.monoPane">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurface}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="{DynamicResource AlcolerFontSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
    </Style>
    <Style Selector="controls|Icon.conversationIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Stroke" Value="{DynamicResource AlcolerTextTertiary}" />
    </Style>
    <Style Selector="Button.toolRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="0,3" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.toolRow:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.toolRow:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
    </Style>
    <Style Selector="Button.toolRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
    </Style>
    <Style Selector="Button.toolRow controls|Icon.disclosure">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.toolRow:pointerover controls|Icon.disclosure">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.toolRow:focus-visible controls|Icon.disclosure">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.agentType">
      <Setter Property="Foreground" Value="{DynamicResource AlcolerAgentGeneral}" />
    </Style>
    <Style Selector="TextBlock.agentType.explore">
      <Setter Property="Foreground" Value="{DynamicResource AlcolerAgentExplore}" />
    </Style>
    <Style Selector="Button.agentRow.running TextBlock.agentLabel">
      <Style.Animations>
        <Animation Duration="0:0:4" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.5" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.5" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="TextBlock.toolStatus">
      <Setter Property="FontSize" Value="{DynamicResource AlcolerFontSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
    </Style>
    <Style Selector="TextBlock.toolStatus.error">
      <Setter Property="Foreground" Value="{DynamicResource AlcolerError}" />
    </Style>
    <Style Selector="Border.noticeRow.error TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AlcolerError}" />
    </Style>
    <Style Selector="StackPanel.assistantRow">
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="StackPanel.assistantRow.hasText">
      <Setter Property="Margin" Value="0,0,0,20" />
    </Style>
    <Style Selector="Expander.thinkingBlock">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel>
            <ToggleButton x:Name="ThinkingToggle" Classes="thinkingToggle" AutomationProperties.Name="Thinking"
                          HorizontalAlignment="Left" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:Icon Classes="conversationIcon" Data="M12 18V5a3 3 0 0 0-5.997-.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.68A4 4 0 1 0 12 18ZM12 18V5a3 3 0 0 1 5.997-.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.68A4 4 0 1 1 12 18M9 13a4.5 4.5 0 0 1-3-4M15 13a4.5 4.5 0 0 0 3-4" />
                <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center" />
                <Grid Width="14" Height="14" VerticalAlignment="Center">
                  <controls:Icon Classes="conversationIcon reasoningChevron thinkingCollapsed" Width="14" Height="14"
                                 Data="{StaticResource AlcolerIconChevronRight}" />
                  <controls:Icon Classes="conversationIcon reasoningChevron thinkingExpanded" Width="14" Height="14"
                                 Data="{StaticResource AlcolerIconChevronDown}" />
                </Grid>
              </StackPanel>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding Content}" IsVisible="{TemplateBinding IsExpanded}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.thinkingToggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="0,3" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.thinkingToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.thinkingToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.thinkingToggle:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
    </Style>
    <Style Selector="ToggleButton.thinkingToggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
    </Style>
    <Style Selector="ToggleButton.thinkingToggle controls|Icon.thinkingExpanded">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToggleButton.thinkingToggle:checked controls|Icon.thinkingCollapsed">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToggleButton.thinkingToggle:checked controls|Icon.thinkingExpanded">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <ScrollViewer x:Name="TimelineScroll" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Visible" AllowAutoHide="False">
      <controls:ConversationLayout x:Name="TimelineLayout" Padding="16,20,16,20" UseResponsiveHorizontalPadding="True">
        <StackPanel MinWidth="0" HorizontalAlignment="Stretch">
          <ItemsControl x:Name="TimelineItems" ItemsSource="{Binding Items}" Background="Transparent">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><controls:ConversationPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.DataTemplates>
              <DataTemplate x:DataType="vm:UserMessageItemViewModel">
                <Border Classes="userRow" Margin="0,0,0,20" CornerRadius="12,2,12,12"
                        HorizontalAlignment="Right" Padding="16,12" BorderThickness="0"
                        Background="{DynamicResource AlcolerSurface}">
                  <StackPanel Spacing="8">
                    <ItemsControl ItemsSource="{Binding Images}" IsVisible="{Binding HasImages}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="parts:FilePart">
                          <controls:ConversationImage ArtifactUri="{Binding ArtifactUri}" MimeType="{Binding MimeType}" FileName="{Binding FileName}"
                                                      ToolTip.Tip="{Binding FileName}" Margin="0,0,6,0" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontFamily="{DynamicResource AlcolerFontPrimary}"
                                         FontSize="{DynamicResource AlcolerFontBase}" LineHeight="24.5"
                                         IsVisible="{Binding !!Text}" Foreground="{DynamicResource AlcolerTextPrimary}" />
                  </StackPanel>
                </Border>
              </DataTemplate>

              <DataTemplate x:DataType="vm:AssistantMessageItemViewModel">
                <StackPanel Classes="assistantRow"
                            Classes.hasText="{Binding MarkdownText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Spacing="12" MinWidth="0" HorizontalAlignment="Stretch">
                  <Expander Classes="thinkingBlock" IsExpanded="{Binding IsReasoningExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch"
                            IsVisible="{Binding ReasoningBlocks, Converter={x:Static conv:TimelineConverters.NonEmpty}}">
                    <Expander.Header>
                      <TextBlock Text="Thinking" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource AlcolerTextTertiary}" />
                    </Expander.Header>
                    <Border Classes="reasoningDetails" Margin="8,12,0,0" Padding="14,0,0,0"
                            BorderThickness="0">
                      <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
                        <SelectableTextBlock TextWrapping="Wrap" FontFamily="{DynamicResource AlcolerFontPrimary}"
                                             FontSize="{DynamicResource AlcolerFontBase}" LineHeight="24.5"
                                             Foreground="{DynamicResource AlcolerTextSecondary}"
                                             Text="{Binding ReasoningBlocks, Converter={x:Static conv:TimelineConverters.JoinLines}}" />
                      </ScrollViewer>
                    </Border>
                  </Expander>
                  <controls:ConversationMarkdown Markdown="{Binding MarkdownText}"
                                                 IsVisible="{Binding MarkdownText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <Rectangle Classes="streamingCaret" HorizontalAlignment="Left" IsVisible="{Binding IsStreaming}" />
                </StackPanel>
              </DataTemplate>

              <DataTemplate x:DataType="vm:AgentCallItemViewModel">
                <Button Classes="toolRow agentRow" Classes.running="{Binding IsRunning}" Margin="0,0,0,4"
                        Click="OnAgentRowClick" ToolTip.Tip="{Binding ToolTipText}"
                        AutomationProperties.Name="{Binding AccessibleText}">
                  <Grid ColumnDefinitions="16,Auto,Auto,Auto,*,Auto" ColumnSpacing="8" MinWidth="0">
                    <controls:Icon Classes="conversationIcon"
                                   Data="M12 8V4H8M5 8h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2ZM9 13v2M15 13v2M1 13v4M23 13v4M9 18h6" />
                    <TextBlock Grid.Column="1" Classes="agentLabel" Text="SubAgent" FontSize="14" FontWeight="Medium"
                               VerticalAlignment="Center" Foreground="{DynamicResource AlcolerTextTertiary}" />
                    <TextBlock Grid.Column="2" Classes="agentType" Classes.explore="{Binding IsExplore}"
                               Text="{Binding AgentType}" ToolTip.Tip="{Binding AgentType}" FontFamily="{DynamicResource AlcolerFontMonospace}"
                               FontSize="14" FontWeight="Medium" MaxWidth="144" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="·" VerticalAlignment="Center" Foreground="{DynamicResource AlcolerTextTertiary}" />
                    <TextBlock Grid.Column="4" Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Foreground="{DynamicResource AlcolerTextTertiary}" />
                    <TextBlock Grid.Column="5" Classes="toolStatus error" Text="{Binding StatusText}"
                               IsVisible="{Binding HasError}" VerticalAlignment="Center" ToolTip.Tip="{Binding ToolTipText}" />
                  </Grid>
                </Button>
              </DataTemplate>

              <DataTemplate x:DataType="vm:ToolCallItemViewModel">
                <StackPanel Margin="0,0,0,4" MinWidth="0" ClipToBounds="True">
                  <Button Classes="toolRow" Click="OnToolRowClick" ToolTip.Tip="{Binding ToolName}">
                    <Grid ColumnDefinitions="16,Auto,*,Auto" ColumnSpacing="8" MinWidth="0">
                      <controls:Icon Grid.Column="0" Classes="conversationIcon" Data="{Binding IconPath, Converter={StaticResource ConversationIcon}}" />
                      <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="14" FontWeight="Medium"
                                 MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 Foreground="{DynamicResource AlcolerTextTertiary}" />
                      <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="14" VerticalAlignment="Center"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource AlcolerTextTertiary}" ToolTip.Tip="{Binding Summary}" />
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    IsVisible="{Binding HasFileChange}" AutomationProperties.Name="File line changes">
                          <TextBlock Text="{Binding AddedLinesText}" IsVisible="{Binding HasAddedLines}"
                                     FontFamily="{DynamicResource AlcolerFontMonospace}" FontSize="{DynamicResource AlcolerFontSmall}"
                                     VerticalAlignment="Center" Foreground="{DynamicResource AlcolerDiffAdded}" />
                          <TextBlock Text="{Binding RemovedLinesText}" IsVisible="{Binding HasRemovedLines}"
                                     FontFamily="{DynamicResource AlcolerFontMonospace}" FontSize="{DynamicResource AlcolerFontSmall}"
                                     VerticalAlignment="Center" Foreground="{DynamicResource AlcolerDiffRemoved}" />
                        </StackPanel>
                        <TextBlock Classes="toolStatus" Classes.error="{Binding HasError}" Text="{Binding DisplayStatusText}"
                                   IsVisible="{Binding ShowStatus}" />
                        <TextBlock Text="{Binding DurationText}" FontSize="{DynamicResource AlcolerFontSmall}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AlcolerTextSecondary}"
                                   AutomationProperties.Name="{Binding AccessibleDurationText}" ToolTip.Tip="{Binding AccessibleDurationText}"
                                   IsVisible="{Binding DurationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <Grid Width="14" Height="14">
                          <controls:Icon Classes="conversationIcon disclosure" Width="14" Height="14"
                                         Data="{StaticResource AlcolerIconChevronRight}" IsVisible="{Binding !IsExpanded}" />
                          <controls:Icon Classes="conversationIcon" Width="14" Height="14"
                                         Data="{StaticResource AlcolerIconChevronDown}" IsVisible="{Binding IsExpanded}" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <ItemsControl Classes="toolImages" ItemsSource="{Binding ImageMedia}" IsVisible="{Binding HasImages}" Margin="24,8,0,4">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="parts:ToolResultMedia">
                        <controls:ConversationImage ArtifactUri="{Binding ArtifactUri}" MimeType="{Binding MimeType}" FileName="{Binding FileName}"
                                                    ToolTip.Tip="{Binding FileName}" Margin="0,0,6,4" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="toolDetails" Margin="8,12,0,0" Padding="14,0,0,0"
                          BorderThickness="0"
                          IsVisible="{Binding IsExpanded}">
                    <StackPanel Spacing="12" MinWidth="0">
                      <StackPanel Spacing="6" IsVisible="{Binding InputJson, Converter={x:Static conv:TimelineConverters.NonEmpty}}">
                        <TextBlock Classes="caption" Text="Input" />
                        <Border Classes="monoPane">
                          <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Auto">
                            <SelectableTextBlock Classes="mono" Text="{Binding InputJson}" />
                          </ScrollViewer>
                        </Border>
                      </StackPanel>
                      <StackPanel Spacing="6" IsVisible="{Binding OutputText, Converter={x:Static conv:TimelineConverters.NonEmpty}}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock Classes="caption" Text="Output" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Classes="ghost openToolOutput" Content="Open in side panel"
                                  Click="OnOpenToolOutputClick" Padding="6,2" FontSize="{DynamicResource AlcolerFontBase}" />
                        </Grid>
                        <Border Classes="monoPane"
                                IsVisible="{Binding ToolName, Converter={x:Static conv:TimelineConverters.TerminalTool}}">
                          <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Auto">
                            <SelectableTextBlock Classes="mono" Text="{Binding OutputText}" />
                          </ScrollViewer>
                        </Border>
                        <Border Classes="monoPane"
                                IsVisible="{Binding ToolName, Converter={x:Static conv:TimelineConverters.TerminalTool}, ConverterParameter=invert}">
                          <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                            <SelectableTextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding OutputText}" />
                          </ScrollViewer>
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </DataTemplate>

              <DataTemplate x:DataType="vm:SystemNoticeItemViewModel">
                <Border Classes="noticeRow" Classes.error="{Binding IsError}" Margin="0,0,0,16" Padding="0,8,0,0"
                        BorderThickness="0">
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Classes="caption" Text="{Binding DisplayKind}" FontWeight="Medium" ToolTip.Tip="{Binding Kind}" />
                    <TextBlock Classes="caption" Text=": " />
                    <TextBlock Classes="caption" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20" />
                  </WrapPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
          <Border Classes="workingBar" Classes.running="{Binding IsWorking}" Margin="0,8,0,0" Padding="0,6" IsHitTestVisible="False"
                  IsVisible="{Binding Composer.IsTurnActive}" AutomationProperties.Name="{Binding ActivityText}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Grid Width="25" Height="18" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" IsVisible="{Binding IsWorking}">
                  <Border Classes="workingDot first"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform></Border>
                  <Border Classes="workingDot second"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform></Border>
                  <Border Classes="workingDot third"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform></Border>
                </StackPanel>
                <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{Binding PhaseText, Converter={StaticResource AlcolerPhaseBrush}}" IsVisible="{Binding !IsWorking}" />
              </Grid>
              <TextBlock Text="{Binding ActivityText}" FontSize="{DynamicResource AlcolerFontBase}" FontWeight="Medium" VerticalAlignment="Center"
                         Foreground="{DynamicResource AlcolerTextPrimary}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </controls:ConversationLayout>
    </ScrollViewer>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24"
                IsVisible="{Binding Items.Count, Converter={StaticResource AlcolerZeroToVisible}}">
      <TextBlock Text="{Binding #TimelineRoot.EmptyTitle}" FontSize="20" FontWeight="Medium" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding #TimelineRoot.EmptyDescription}" FontSize="14" TextWrapping="Wrap"
                 TextAlignment="Center" Foreground="{DynamicResource AlcolerTextSecondary}" />
    </StackPanel>
  </Grid>
</UserControl>
