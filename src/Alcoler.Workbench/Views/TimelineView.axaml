<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Alcoler.Workbench.Converters"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:ct="using:ColorTextBlock.Avalonia"
             xmlns:vm="using:Alcoler.Workbench.ViewModel"
             xmlns:controls="using:Alcoler.Workbench.Controls"
             x:Class="Alcoler.Workbench.Views.TimelineView"
             x:DataType="vm:ConversationViewModel"
             Background="{DynamicResource AlcolerBackground}">
  <UserControl.Styles>
    <Style Selector="Border.workingDot">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{DynamicResource AlcolerTextSecondary}" />
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Rectangle.streamingCaret">
      <Setter Property="Width" Value="2" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Fill" Value="{DynamicResource AlcolerTextPrimary}" />
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.05" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas, JetBrains Mono" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="Border.monoPane">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurface}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.terminalPane">
      <Setter Property="Background" Value="{DynamicResource AlcolerTerminalBackground}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.terminalPane SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTerminalForeground}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
    </Style>
    <Style Selector="Button.toolRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="0,3" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.toolRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.toolRow controls|Icon.disclosure">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.toolRow:pointerover controls|Icon.disclosure">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.toolRow:focus-visible controls|Icon.disclosure">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Expander.thinkingBlock">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel Spacing="4">
            <ToggleButton x:Name="ThinkingToggle" Background="Transparent" BorderThickness="0" Padding="0,3"
                          HorizontalContentAlignment="Left" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:Icon Classes="icon small" Data="M12 3a4 4 0 0 0-7 3 4 4 0 0 0-2 7 4 4 0 0 0 5 6c1 3 4 2 4 0V3M12 3a4 4 0 0 1 7 3 4 4 0 0 1 2 7 4 4 0 0 1-5 6c-1 3-4 2-4 0" />
                <ContentPresenter Content="{TemplateBinding Header}" />
                <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconChevronRight}" />
              </StackPanel>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding Content}" IsVisible="{TemplateBinding IsExpanded}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>

  <Grid>
    <ScrollViewer x:Name="TimelineScroll" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="800" Margin="16,24,16,16" HorizontalAlignment="Stretch">
        <ItemsControl x:Name="TimelineItems" ItemsSource="{Binding Items}" Background="Transparent">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.DataTemplates>
            <DataTemplate x:DataType="vm:UserMessageItemViewModel">
              <Border Classes="userRow" Margin="0,4,0,24" CornerRadius="12,2,12,12"
                      MaxWidth="576" HorizontalAlignment="Right" Padding="16,12"
                      BorderThickness="1" Background="{DynamicResource AlcolerSurface}"
                      BorderBrush="{DynamicResource AlcolerBorder}">
                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                     Foreground="{DynamicResource AlcolerTextPrimary}" />
              </Border>
            </DataTemplate>

            <DataTemplate x:DataType="vm:AssistantMessageItemViewModel">
              <StackPanel Classes="assistantRow" Margin="0,0,0,16" Spacing="8" MinWidth="0" HorizontalAlignment="Stretch">
                <Expander Classes="thinkingBlock" IsExpanded="False" HorizontalAlignment="Stretch"
                          IsVisible="{Binding ReasoningBlocks, Converter={x:Static conv:TimelineConverters.NonEmpty}}">
                  <Expander.Header>
                    <TextBlock Text="Thinking" FontSize="13" Foreground="{DynamicResource AlcolerTextSecondary}" />
                  </Expander.Header>
                  <SelectableTextBlock Margin="16,4,0,0" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{DynamicResource AlcolerTextSecondary}"
                                       Text="{Binding ReasoningBlocks, Converter={x:Static conv:TimelineConverters.JoinLines}}" />
                </Expander>
                <md:MarkdownScrollViewer Markdown="{Binding MarkdownText}" SelectionEnabled="True"
                                         IsVisible="{Binding MarkdownText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <md:MarkdownScrollViewer.Styles>
                    <Style Selector="ct|CTextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
                    </Style>
                    <Style Selector="ct|CTextBlock.Paragraph">
                      <Setter Property="FontSize" Value="14" />
                      <Setter Property="LineHeight" Value="24" />
                    </Style>
                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ct|CCode">
                      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
                      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
                      <Setter Property="MonospaceFontFamily" Value="Consolas, JetBrains Mono" />
                    </Style>
                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ct|CHyperlink">
                      <Setter Property="Foreground" Value="{DynamicResource AlcolerAccent}" />
                      <Setter Property="IsUnderline" Value="True" />
                    </Style>
                    <Style Selector="TextBlock">
                      <Setter Property="FontSize" Value="14" />
                      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
                    </Style>
                  </md:MarkdownScrollViewer.Styles>
                </md:MarkdownScrollViewer>
                <Rectangle Classes="streamingCaret" HorizontalAlignment="Left" IsVisible="{Binding IsStreaming}" />
              </StackPanel>
            </DataTemplate>

            <DataTemplate x:DataType="vm:ToolCallItemViewModel">
              <StackPanel Margin="0,2" MinWidth="0">
                <Button Classes="toolRow" Click="OnToolRowClick" ToolTip.Tip="{Binding ToolName}">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8" MinWidth="0">
                    <controls:Icon Grid.Column="0" Classes="icon" Data="{StaticResource AlcolerIconWrench}"
                          Stroke="{DynamicResource AlcolerTextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding ToolName}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource AlcolerTextSecondary}" />
                    <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="13" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AlcolerTextSecondary}" />
                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{Binding Status, Converter={x:Static conv:TimelineConverters.StatusBrush}}" />
                    <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="11" VerticalAlignment="Center"
                               Classes="caption" IsVisible="{Binding DurationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <controls:Icon Grid.Column="5" Classes="icon small disclosure" Data="{StaticResource AlcolerIconChevronRight}"
                          IsVisible="{Binding !IsExpanded}" Stroke="{DynamicResource AlcolerTextSecondary}" />
                    <controls:Icon Grid.Column="5" Classes="icon small" Data="{StaticResource AlcolerIconChevronDown}"
                          IsVisible="{Binding IsExpanded}" Stroke="{DynamicResource AlcolerTextSecondary}" />
                  </Grid>
                </Button>
                <Border Classes="toolDetails" Margin="8,6,0,6" Padding="14,0,0,0"
                        BorderBrush="{DynamicResource AlcolerBorder}" BorderThickness="1,0,0,0"
                        IsVisible="{Binding IsExpanded}">
                  <StackPanel Spacing="8" MinWidth="0">
                    <StackPanel Spacing="4" IsVisible="{Binding InputJson, Converter={x:Static conv:TimelineConverters.NonEmpty}}">
                      <TextBlock Classes="caption" Text="Input" />
                      <Border Classes="monoPane">
                        <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Auto">
                          <SelectableTextBlock Classes="mono" Text="{Binding InputJson}" />
                        </ScrollViewer>
                      </Border>
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding OutputText, Converter={x:Static conv:TimelineConverters.NonEmpty}}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Classes="caption" Text="Output" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost openToolOutput" Content="Open in side panel"
                                Click="OnOpenToolOutputClick" Padding="6,2" FontSize="11" />
                      </Grid>
                      <Border Classes="terminalPane"
                              IsVisible="{Binding ToolName, Converter={x:Static conv:TimelineConverters.TerminalTool}}">
                        <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Auto">
                          <SelectableTextBlock Classes="mono" Text="{Binding OutputText}" />
                        </ScrollViewer>
                      </Border>
                      <Border Classes="monoPane"
                              IsVisible="{Binding ToolName, Converter={x:Static conv:TimelineConverters.TerminalTool}, ConverterParameter=invert}">
                        <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                          <SelectableTextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding OutputText}" />
                        </ScrollViewer>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </DataTemplate>

            <DataTemplate x:DataType="vm:SystemNoticeItemViewModel">
              <Border Classes="noticeRow" Margin="0,12" Padding="0,6" BorderThickness="0,1,0,0"
                      BorderBrush="{DynamicResource AlcolerBorder}">
                <WrapPanel Orientation="Horizontal">
                  <TextBlock FontSize="12" Text="{Binding Kind}" Foreground="{DynamicResource AlcolerTextSecondary}" />
                  <TextBlock FontSize="12" Text=": " Foreground="{DynamicResource AlcolerTextSecondary}" />
                  <TextBlock FontSize="12" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource AlcolerTextSecondary}" />
                </WrapPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
        <Border Classes="workingBar" Margin="0,12,0,0" Padding="0,4" IsHitTestVisible="False"
                IsVisible="{Binding Composer.IsTurnActive}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="workingDot" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PhaseText}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource AlcolerTextSecondary}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24"
                IsVisible="{Binding Items.Count, Converter={StaticResource AlcolerZeroToVisible}}">
      <TextBlock Text="What can I help you with?" FontSize="20" FontWeight="Medium" HorizontalAlignment="Center" />
      <TextBlock Text="Ask a question, plan a change, or describe a task." FontSize="13" TextWrapping="Wrap"
                 TextAlignment="Center" Foreground="{DynamicResource AlcolerTextSecondary}" />
    </StackPanel>
  </Grid>
</UserControl>
