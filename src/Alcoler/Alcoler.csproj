<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\Alcoler.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.4" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.4" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="11.4.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="11.0.3" />
    <PackageReference Include="Porta.Pty" Version="2.2.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Alcoler.Tests" />
    <EmbeddedResource Include="Models\ModelDefaults.json" />
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\Icons\Alcoler-mark.png" />
    <AvaloniaResource Include="Assets\Icons\Alcoler.ico" />
    <None Update="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Alcoler.Contracts\Alcoler.Contracts.csproj" />
    <ProjectReference Include="..\Alcoler.Kernel\Alcoler.Kernel.csproj" />
    <!-- The SDK builds references RID-less, so the publish RID reaches Adapters
         only through AlcoGrepTargetRid (RuntimeIdentifier is stripped there). -->
    <ProjectReference Include="..\Alcoler.Adapters\Alcoler.Adapters.csproj"
                      AdditionalProperties="AlcoGrepTargetRid=$(RuntimeIdentifier)" />
    <ProjectReference Include="..\Alcoler.Browser\Alcoler.Browser.csproj" />
  </ItemGroup>
</Project>
