<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alcoler.ViewModel"
             xmlns:controls="using:Alcoler.Controls"
             xmlns:loc="using:Alcoler.Localization"
             x:Class="Alcoler.Controls.ContextUsageView"
             x:DataType="vm:ContextUsageViewModel"
             x:Name="Root" IsVisible="{Binding IsVisible, FallbackValue=False}">
  <Grid>
    <Button x:Name="ContextTrigger" Classes="ghost" Width="28" Height="28" MinHeight="0" Padding="0"
            CornerRadius="8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
            AutomationProperties.Name="{Binding AccessibleText}">
      <Grid Width="14" Height="14">
        <controls:Icon x:Name="ContextRingTrack" Width="14" Height="14" StrokeThickness="4" Opacity="0.25"
                       Stroke="{DynamicResource AlcolerTextSecondary}"
                       Data="M12 2A10 10 0 1 1 12 22A10 10 0 1 1 12 2" />
        <controls:Icon x:Name="ContextRingFill" Width="14" Height="14" StrokeThickness="4" Opacity="0.7"
                       Stroke="{DynamicResource AlcolerTextSecondary}" />
      </Grid>
    </Button>
    <Popup x:Name="ContextPopup" Placement="TopEdgeAlignedRight" PlacementTarget="{Binding #ContextTrigger}"
           VerticalOffset="0" IsLightDismissEnabled="False" TakesFocusFromNativeControl="False" WindowManagerAddShadowHint="False">
      <Border x:Name="ContextHoverBridge" Background="Transparent" Padding="0,0,0,2">
      <Border x:Name="ContextPopover" Width="320" Padding="12" CornerRadius="12"
              BorderThickness="0" Background="{DynamicResource AlcolerPopover}" BoxShadow="0 4 12 0 #26000000">
        <StackPanel Spacing="12">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,4">
              <TextBlock Text="{loc:Loc context_capacity}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource AlcolerTextPrimary}" />
              <TextBlock x:Name="ContextSummary" Grid.Column="1" Text="{Binding Summary}" FontSize="12"
                         FontFamily="{DynamicResource AlcolerFontMonospace}" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Foreground="{DynamicResource AlcolerTextSecondary}" />
            </Grid>
            <controls:ContextUsageProgress x:Name="ContextProgress" Height="8" Usage="{Binding}" />
          </StackPanel>
          <ItemsControl x:Name="ContextBreakdown" ItemsSource="{Binding Segments}" IsVisible="{Binding HasBreakdown}"
                        AutomationProperties.Name="{loc:Loc context_breakdown_a11y}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContextUsageSegment">
                <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="8">
                  <Border Width="8" Height="8" CornerRadius="2" VerticalAlignment="Center" BorderThickness="0" Background="{DynamicResource AlcolerInfo}" Opacity="{Binding ToneOpacity}" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource AlcolerTextSecondary}" />
                  <TextBlock Grid.Column="2" Text="{Binding PercentText}" FontSize="12" FontFamily="{DynamicResource AlcolerFontMonospace}"
                             MinWidth="40" TextAlignment="Right" Foreground="{DynamicResource AlcolerTextPrimary}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border IsVisible="{Binding HasFooterStats}" BorderThickness="0"
                  Padding="0,12,0,0">
            <StackPanel Spacing="8">
              <Grid IsVisible="{Binding HasCacheHitRate}" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{loc:Loc context_cache_hit_rate}" FontSize="12" Foreground="{DynamicResource AlcolerTextSecondary}" />
                <TextBlock Grid.Column="1" Text="{Binding CacheHitRateText}" FontSize="12" FontFamily="{DynamicResource AlcolerFontMonospace}"
                           Foreground="{DynamicResource AlcolerTextPrimary}" />
              </Grid>
              <Grid IsVisible="{Binding HasOutputSpeed}" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{loc:Loc context_output_speed}" FontSize="12" Foreground="{DynamicResource AlcolerTextSecondary}" />
                <TextBlock Grid.Column="1" Text="{Binding OutputSpeedText}" FontSize="12" FontFamily="{DynamicResource AlcolerFontMonospace}"
                           Foreground="{DynamicResource AlcolerTextPrimary}" />
              </Grid>
            </StackPanel>
          </Border>
          <ContentControl x:Name="QuotaHost" Content="{Binding #Root.QuotaContent}" />
        </StackPanel>
      </Border>
      </Border>
    </Popup>
  </Grid>
</UserControl>
