<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             x:Class="Alcoler.Controls.ConversationMarkdown"
             Classes="conversationMarkdown">
  <UserControl.Styles>
    <StyleInclude Source="avares://Alcoler/Controls/ConversationMarkdownStyles.axaml" />
  </UserControl.Styles>
  <md:MarkdownScrollViewer x:Name="Viewer" MarkdownStyleName="Empty"
                           SelectionEnabled="True" SelectionBrush="{DynamicResource AlcolerSelected}" />
</UserControl>
