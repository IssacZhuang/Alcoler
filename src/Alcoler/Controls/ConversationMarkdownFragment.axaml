<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Alcoler.Controls.ConversationMarkdownFragment"
             Classes="conversationMarkdown"
             HorizontalAlignment="Stretch">
  <UserControl.Styles>
    <StyleInclude Source="avares://Alcoler/Controls/ConversationMarkdownStyles.axaml" />
  </UserControl.Styles>
  <ContentControl x:Name="Host" HorizontalContentAlignment="Stretch" />
</UserControl>
