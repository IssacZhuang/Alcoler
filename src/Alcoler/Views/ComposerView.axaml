<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Alcoler.Converters"
             xmlns:events="using:Alcoler.Contracts.Events"
             xmlns:vm="using:Alcoler.ViewModel"
             xmlns:local="using:Alcoler"
             xmlns:controls="using:Alcoler.Controls"
             xmlns:loc="using:Alcoler.Localization"
             x:Class="Alcoler.Views.ComposerView"
             x:DataType="vm:IComposerHost"
             Background="{DynamicResource AlcolerBackground}">
  <UserControl.Styles>
    <Style Selector="Border.composerShell">
      <Setter Property="Background" Value="{DynamicResource AlcolerComposer}" />
    </Style>
    <Style Selector="Border.composerShell:pointerover">
      <Setter Property="Background" Value="{DynamicResource AlcolerComposerHigh}" />
    </Style>
    <Style Selector="Border.composerShell:focus-within">
      <Setter Property="Background" Value="{DynamicResource AlcolerComposerHigh}" />
    </Style>
    <Style Selector="Button.toolbarAction">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.modePicker">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.modePicker.fullAccess TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AlcolerWarning}" />
    </Style>
    <Style Selector="Button.modePicker.fullAccess controls|Icon.icon">
      <Setter Property="Stroke" Value="{DynamicResource AlcolerWarning}" />
    </Style>
    <Style Selector="Button.toolbarPicker">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="{DynamicResource AlcolerFontBase}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="UserControl.compact TextBlock.modeLabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.skillList ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <controls:ConversationLayout Padding="16,8,16,16">
    <StackPanel Spacing="8">
      <Border x:Name="QueueStrip" IsVisible="{Binding HasQueuedInput}"
              Background="{DynamicResource AlcolerSurface}"
              BorderThickness="0"
              CornerRadius="12" Padding="12,8" MaxHeight="96">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc composer_queued_messages}" FontSize="{DynamicResource AlcolerFontSmall}" Foreground="{DynamicResource AlcolerTextSecondary}" />
            <ItemsControl x:Name="QueueList" ItemsSource="{Binding Queue}">
              <ItemsControl.Template>
                <ControlTemplate><ItemsPresenter /></ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="events:QueuedInput">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                    <TextBlock Text="{Binding Text}" FontSize="{DynamicResource AlcolerFontBase}" FontFamily="{DynamicResource AlcolerFontPrimary}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="{DynamicResource AlcolerTextPrimary}" />
                    <Button Grid.Column="1" Classes="icon tiny" VerticalAlignment="Center" Click="OnSendQueuedNowClick"
                            ToolTip.Tip="{loc:Loc composer_send_queued_now_tooltip}" AutomationProperties.Name="{loc:Loc composer_send_queued_now_a11y}">
                      <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconArrowUp}" />
                    </Button>
                    <Button Grid.Column="2" Classes="icon tiny" VerticalAlignment="Center" Click="OnWithdrawQueuedClick"
                            ToolTip.Tip="{loc:Loc composer_withdraw_tooltip}" AutomationProperties.Name="{loc:Loc composer_withdraw_a11y}">
                      <controls:Icon Classes="icon small" Data="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L9 17l-4 1 1-4ZM15 5l3 3" />
                    </Button>
                    <Button Grid.Column="3" Classes="icon tiny" VerticalAlignment="Center" Click="OnDeleteQueuedClick"
                            ToolTip.Tip="{loc:Loc composer_delete_queued}" AutomationProperties.Name="{loc:Loc composer_delete_queued}">
                      <controls:Icon Classes="icon small" Data="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border x:Name="SkillPanel" IsVisible="False" MaxHeight="220" Margin="0,0,0,4"
              Background="{DynamicResource AlcolerPopover}"
              BorderBrush="{DynamicResource AlcolerSurfaceHigh}" BorderThickness="1"
              CornerRadius="12" Padding="4" BoxShadow="0 4 12 0 #26000000">
        <ListBox x:Name="SkillSuggestions" Classes="skillList" SelectionMode="Single" MaxHeight="212">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:ComposerSkillEntry">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource AlcolerFontBase}" FontFamily="{DynamicResource AlcolerFontPrimary}"
                           FontWeight="Medium" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="{DynamicResource AlcolerFontSmall}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource AlcolerTextSecondary}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border x:Name="ComposerShell" Classes="composerShell"
              BorderThickness="0"
              CornerRadius="16" Padding="12">
        <StackPanel Spacing="12">
          <ItemsControl ItemsSource="{Binding Composer.Attachments}" IsVisible="{Binding Composer.HasAttachments}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ComposerImageAttachment">
                <Border BorderThickness="0" CornerRadius="8" Padding="4" Margin="0,0,6,6">
                  <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                    <Button Classes="ghost" Padding="0" Cursor="Hand" Click="OnPreviewImageClick"
                            ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{loc:Loc markdown_preview_image}">
                      <Image Source="{Binding Thumbnail}" Width="72" Height="56" Stretch="UniformToFill" />
                    </Button>
                    <Button Grid.Column="1" Classes="icon toolbarAction" VerticalAlignment="Top" Click="OnRemoveImageClick" ToolTip.Tip="{loc:Loc composer_remove_image}">
                      <controls:Icon Classes="icon small" Data="M6 6l12 12 M18 6 6 18" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBox x:Name="InputBox" Classes="bare"
                   Text="{Binding Composer.Draft, Mode=TwoWay}"
                   Watermark="{loc:Loc composer_watermark}"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="40" MaxHeight="160" VerticalContentAlignment="Top"
                   FontSize="{DynamicResource AlcolerFontBase}" LineHeight="20" FontFamily="{DynamicResource AlcolerFontPrimary}" />

          <TextBlock Text="{Binding Composer.InputError}" IsVisible="{Binding !!Composer.InputError}"
                     Foreground="{DynamicResource AlcolerWarning}" FontSize="{DynamicResource AlcolerFontSmall}" TextWrapping="Wrap" />
          <Grid x:Name="ComposerToolbar" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6" Height="28">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
              <Button x:Name="ModeSelector" Classes="modePicker" Classes.fullAccess="{Binding Composer.IsFullAccess}"
                      ToolTip.Tip="{loc:Loc composer_permissions_tooltip}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc composer_permissions}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <controls:Icon Classes="icon" Data="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z M9 12l2 2 4-4" />
                  <TextBlock Classes="modeLabel" Text="{Binding Composer.ModeLabel}" FontSize="{DynamicResource AlcolerFontBase}" VerticalAlignment="Center" />
                  <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconChevronDown}" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedLeft">
                    <StackPanel Spacing="8" MinWidth="220" MaxWidth="256">
                      <TextBlock Text="{loc:Loc composer_permissions}" FontSize="{DynamicResource AlcolerFontSmall}" Foreground="{DynamicResource AlcolerTextSecondary}" />
                      <RadioButton GroupName="ComposerMode" Content="{loc:Loc composer_mode_build}" ToolTip.Tip="{loc:Loc composer_mode_build_tooltip}"
                                   IsChecked="{Binding Composer.Mode, Mode=TwoWay, Converter={x:Static converters:ComposerConverters.EnumEquals}, ConverterParameter=Build}" />
                      <RadioButton GroupName="ComposerMode" Content="{loc:Loc composer_mode_edit}" ToolTip.Tip="{loc:Loc composer_mode_edit_tooltip}"
                                   IsChecked="{Binding Composer.Mode, Mode=TwoWay, Converter={x:Static converters:ComposerConverters.EnumEquals}, ConverterParameter=Edit}" />
                      <RadioButton GroupName="ComposerMode" Content="{loc:Loc composer_mode_full_access}" ToolTip.Tip="{loc:Loc composer_mode_full_access_tooltip}"
                                   IsChecked="{Binding Composer.Mode, Mode=TwoWay, Converter={x:Static converters:ComposerConverters.EnumEquals}, ConverterParameter=Yolo}" />
                      <Separator />
                      <CheckBox Content="{loc:Loc composer_plan_mode}" ToolTip.Tip="{loc:Loc composer_plan_mode_tooltip}"
                                IsChecked="{Binding Composer.PlanEnabled, Mode=TwoWay}" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Border x:Name="PlanModeBadge" Background="Transparent" Padding="0" VerticalAlignment="Center"
                      IsVisible="{Binding Composer.IsPlanMode}"
                      ToolTip.Tip="{loc:Loc composer_plan_badge_tooltip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="1" Height="12" Background="{DynamicResource AlcolerSurfaceHigh}" />
                  <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconPlan}" />
                  <TextBlock Text="{loc:Loc workbench_plan}" FontSize="{DynamicResource AlcolerFontBase}"
                             Foreground="{DynamicResource AlcolerTextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Button x:Name="StatusTrigger" Classes="modePicker" Click="OnStatusClick" IsVisible="False" VerticalAlignment="Center"
                      ToolTip.Tip="{loc:Loc composer_show_activities}" AutomationProperties.Name="{loc:Loc composer_show_activities}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <controls:Icon Classes="icon" Data="M4 4h16v16H4ZM7 8l3 3-3 3M12 15h5" />
                  <TextBlock x:Name="StatusTriggerText" FontSize="{DynamicResource AlcolerFontBase}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>

            <Button x:Name="ModelSelector" Grid.Column="3" Classes="ghost toolbarPicker"
                    MinWidth="40" MaxWidth="240" HorizontalAlignment="Right"
                    Click="OnModelPickerClick" AutomationProperties.Name="{loc:Loc composer_choose_model}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="ModelLabel" MaxWidth="210" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconChevronDown}" />
              </StackPanel>
              <Button.Flyout><MenuFlyout Placement="TopEdgeAlignedLeft" /></Button.Flyout>
            </Button>

            <controls:ContextUsageView x:Name="ContextUsageHost" Grid.Column="2" DataContext="{Binding ContextUsage}"
                                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button x:Name="ThoughtLevelSelector" Classes="ghost toolbarPicker" MinWidth="66" MaxWidth="112"
                      ToolTip.Tip="{loc:Loc composer_reasoning_tooltip}" IsVisible="{Binding !!ThoughtLevels.Count}" Click="OnThoughtPickerClick" AutomationProperties.Name="{loc:Loc composer_reasoning}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <controls:Icon Classes="icon small" Data="M12 18V5 M12 5C8 0 3 4 5 8 1 10 3 15 6 15c-1 5 5 7 6 3 M12 5c4-5 9-1 7 3 4 2 2 7-1 7 1 5-5 7-6 3" />
                  <TextBlock Text="{Binding ThoughtLevel}" FontSize="{DynamicResource AlcolerFontBase}"
                             LineHeight="{DynamicResource AlcolerIconSizeSmall}" VerticalAlignment="Center" />
                  <controls:Icon x:Name="ThoughtChevron" Classes="icon small" Data="{StaticResource AlcolerIconChevronDown}" />
                </StackPanel>
                <Button.Flyout><MenuFlyout Placement="TopEdgeAlignedLeft" /></Button.Flyout>
              </Button>
              <Button x:Name="StopButton" Classes="icon toolbarAction"
                      IsVisible="{Binding Composer.ShowStop}" Click="OnStopClick" ToolTip.Tip="{loc:Loc status_stop}">
                <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconSquare}"
                      Stroke="{DynamicResource AlcolerTextPrimary}" Fill="{DynamicResource AlcolerTextPrimary}" />
              </Button>
              <Button x:Name="SendButton" Classes="primary icon toolbarAction"
                      IsVisible="{Binding !Composer.ShowStop}" IsEnabled="{Binding Composer.CanSend}" Click="OnSendClick" ToolTip.Tip="{Binding Composer.SendHint}" AutomationProperties.Name="{loc:Loc composer_send_a11y}">
                <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconArrowUp}" />
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </controls:ConversationLayout>
</UserControl>
