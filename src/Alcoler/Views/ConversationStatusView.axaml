<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alcoler.ViewModel"
             xmlns:controls="using:Alcoler.Controls"
             xmlns:views="using:Alcoler.Views"
             xmlns:loc="using:Alcoler.Localization"
             x:Class="Alcoler.Views.ConversationStatusView"
             x:Name="StatusView"
             x:DataType="vm:ConversationStatusViewModel"
             AutomationProperties.Name="{loc:Loc status_a11y}"
             HorizontalAlignment="Right" VerticalAlignment="Top"
             MaxWidth="320" MaxHeight="512" IsVisible="{Binding IsCardVisible, FallbackValue=False}">
  <UserControl.Resources>
    <views:ConversationIconConverter x:Key="ConversationIcon" />
    <DataTemplate x:Key="TodoRow" x:DataType="vm:StatusTodo">
      <Border Classes="todoRow" MinHeight="32" Padding="8,6" CornerRadius="8"
              ToolTip.Tip="{Binding Content}" AutomationProperties.Name="{Binding Content}"
              AutomationProperties.HelpText="{Binding Status}">
        <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
          <controls:Icon Classes="icon todoIcon" Classes.completed="{Binding IsCompleted}"
                         Classes.active="{Binding IsActive}" VerticalAlignment="Top" Margin="0,2,0,0"
                         Data="{Binding IconPath, Converter={StaticResource ConversationIcon}}" />
          <TextBlock Grid.Column="1" Classes="todoText" Classes.completed="{Binding IsCompleted}"
                     Text="{Binding Content}" FontSize="14" LineHeight="20" MaxLines="2"
                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="TerminalRow" x:DataType="vm:StatusActivity">
      <Grid ColumnDefinitions="*,Auto">
        <Button Classes="statusRow activityRow" Click="OnActivityClick" ToolTip.Tip="{Binding Title}"
                AutomationProperties.Name="{Binding Title}">
          <Grid ColumnDefinitions="16,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
            <controls:Icon Classes="icon" VerticalAlignment="Top" Margin="0,2,0,0"
                           Data="M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1ZM7 8l4 4-4 4M13 16h4" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" LineHeight="20"
                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="activityDetail" Text="{Binding DurationText}" />
              <TextBlock Classes="activityDetail" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                         MaxWidth="120" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Grid.Column="1" Classes="stopActivity" Content="{loc:Loc status_stop}" Click="OnStopActivityClick"
                IsVisible="{Binding CanStop}" AutomationProperties.Name="{loc:Loc status_stop_terminal}"
                ToolTip.Tip="{loc:Loc status_stop_this_terminal}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="AgentRow" x:DataType="vm:StatusActivity">
      <Grid ColumnDefinitions="*,Auto">
        <Button Classes="statusRow activityRow" Click="OnActivityClick" ToolTip.Tip="{Binding Title}"
                AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding DetailText}">
          <Grid ColumnDefinitions="16,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
            <controls:Icon Classes="icon agentIcon" Classes.running="{Binding CanStop}"
                           Classes.completed="{Binding IsCompleted}" Classes.failed="{Binding IsFailed}"
                           Classes.cancelled="{Binding IsCancelled}" VerticalAlignment="Top" Margin="0,2,0,0"
                           Data="M12 8V4H8M5 8h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2ZM9 13v2M15 13v2M1 13v4M23 13v4M9 18h6" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" LineHeight="20"
                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="activityDetail" Text="{Binding DurationText}" />
              <TextBlock Classes="activityDetail" Text="{Binding DetailText}" ToolTip.Tip="{Binding DetailText}"
                         TextTrimming="CharacterEllipsis" MaxWidth="160" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Grid.Column="1" Classes="stopActivity" Content="{loc:Loc status_stop}" Click="OnStopActivityClick"
                IsVisible="{Binding CanStop}" AutomationProperties.Name="{loc:Loc status_stop_agent}"
                ToolTip.Tip="{loc:Loc status_stop_this_agent}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.statusRow">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.statusRow:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.statusRow:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
    </Style>
    <Style Selector="Button.activityRow">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Button.stopActivity">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="TextBlock.activityDetail">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
    </Style>
    <Style Selector="Border.todoRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
    </Style>
    <Style Selector="controls|Icon.todoIcon">
      <Setter Property="Stroke" Value="{DynamicResource AlcolerTextTertiary}" />
    </Style>
    <Style Selector="controls|Icon.todoIcon.active">
      <Setter Property="Stroke" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="controls|Icon.todoIcon.completed">
      <Setter Property="Stroke" Value="{DynamicResource AlcolerSuccess}" />
    </Style>
    <Style Selector="controls|Icon.agentIcon">
      <Setter Property="Stroke" Value="{DynamicResource AlcolerTextTertiary}" />
    </Style>
    <Style Selector="controls|Icon.agentIcon.running">
      <Setter Property="Stroke" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="controls|Icon.agentIcon.completed">
      <Setter Property="Stroke" Value="{DynamicResource AlcolerSuccess}" />
    </Style>
    <Style Selector="controls|Icon.agentIcon.failed">
      <Setter Property="Stroke" Value="{DynamicResource AlcolerError}" />
    </Style>
    <Style Selector="controls|Icon.agentIcon.cancelled">
      <Setter Property="Stroke" Value="{DynamicResource AlcolerWarning}" />
    </Style>
    <Style Selector="TextBlock.todoText.completed">
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextTertiary}" />
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="Button.cardControl">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.summaryButton">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,0,12,0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.summaryButton controls|Icon.summaryMaximize">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.summaryButton:pointerover controls|Icon.summaryIcon">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.summaryButton:focus-visible controls|Icon.summaryIcon">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.summaryButton:pointerover controls|Icon.summaryMaximize">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.summaryButton:focus-visible controls|Icon.summaryMaximize">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Expander.statusSection">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel>
            <ToggleButton Classes="sectionHeader" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
              <Grid ColumnDefinitions="*,14" ColumnSpacing="4">
                <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  VerticalAlignment="Center" />
                <Grid Grid.Column="1" Width="14" Height="14" VerticalAlignment="Center">
                  <controls:Icon Classes="icon small sectionChevron sectionClosed" Data="{StaticResource AlcolerIconChevronRight}" />
                  <controls:Icon Classes="icon small sectionChevron sectionOpen" Data="{StaticResource AlcolerIconChevronDown}" />
                </Grid>
              </Grid>
            </ToggleButton>
            <ContentPresenter Classes="sectionBody" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              IsVisible="{TemplateBinding IsExpanded}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Expander.statusSection[IsExpanded=True] /template/ ContentPresenter.sectionBody">
      <Style.Animations>
        <Animation Duration="0:0:0.2" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="ToggleButton.sectionHeader">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,0,64,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.sectionHeader:checked">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader:checked:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader controls|Icon.sectionChevron">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader:pointerover controls|Icon.sectionChevron">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader:focus-visible controls|Icon.sectionChevron">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader controls|Icon.sectionOpen">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader:checked controls|Icon.sectionClosed">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToggleButton.sectionHeader:checked controls|Icon.sectionOpen">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="TextBlock.statusHeading">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.statusCount">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="FlyoutPresenter.statusFlyout">
      <Setter Property="Background" Value="{DynamicResource AlcolerPopover}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="ToolTip.statusPreview">
      <Setter Property="Background" Value="{DynamicResource AlcolerPopover}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="StatusShell" CornerRadius="16" BorderThickness="0"
          Background="{DynamicResource AlcolerPopover}"
          BoxShadow="0 4 12 0 #26000000">
    <Grid>
      <Button x:Name="SummaryButton" Classes="summaryButton" Click="OnExpandClick"
              IsVisible="{Binding !#StatusView.IsExpanded}" ToolTip.Tip="{loc:Loc status_expand}"
              AutomationProperties.Name="{loc:Loc status_expand}">
        <Grid ColumnDefinitions="16,*" ColumnSpacing="6">
          <Grid Width="16" Height="16" VerticalAlignment="Center">
            <controls:Icon Classes="icon summaryIcon" Stroke="{DynamicResource AlcolerTextPrimary}"
                           Data="{Binding SummaryIconPath, Converter={StaticResource ConversationIcon}}" />
            <controls:Icon Classes="icon summaryMaximize" Stroke="{DynamicResource AlcolerTextPrimary}"
                           Data="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
          </Grid>
          <TextBlock Grid.Column="1" Text="{Binding SummaryText}" FontSize="14" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </Grid>
      </Button>

      <ScrollViewer x:Name="StatusScroll" IsVisible="{Binding #StatusView.IsExpanded}"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8" Spacing="8">
          <Border x:Name="GitContainer" IsVisible="{Binding HasGit}">
            <Expander x:Name="GitSection" Classes="statusSection" IsExpanded="True" AutomationProperties.Name="{loc:Loc status_git_tools}">
              <Expander.Header><TextBlock Classes="statusHeading" Text="{loc:Loc status_git_tools}" /></Expander.Header>
              <ScrollViewer MaxHeight="192" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel>
                  <Button x:Name="ChangesButton" Classes="statusRow" Height="32" Click="OnReviewClick"
                          AutomationProperties.Name="{loc:Loc status_review_changes}">
                    <Grid ColumnDefinitions="16,*,Auto,Auto" ColumnSpacing="8">
                      <controls:Icon Classes="icon" Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8ZM14 2v6h6M8 13h6M11 10v6M8 19h6" />
                      <TextBlock Grid.Column="1" Text="{loc:Loc status_changes}" FontSize="14" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding GitAddedText}" IsVisible="{Binding HasGitLineChanges}"
                                 FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource AlcolerDiffAdded}" />
                      <TextBlock Grid.Column="3" Text="{Binding GitRemovedText}" IsVisible="{Binding HasGitLineChanges}"
                                 FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource AlcolerDiffRemoved}" />
                      <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding GitFileCountText}"
                                 IsVisible="{Binding !HasGitLineChanges}" Classes="statusCount" />
                    </Grid>
                  </Button>
                  <Button x:Name="BranchButton" Classes="statusRow" Height="32" IsEnabled="{Binding !Git.IsBusy}"
                          AutomationProperties.Name="Switch branch" ToolTip.Tip="{Binding Git.CurrentBranch}">
                    <Grid ColumnDefinitions="16,*,14" ColumnSpacing="8">
                      <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconGitBranch}" />
                      <TextBlock Grid.Column="1" Text="{Binding Git.CurrentBranch}" FontSize="14"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <controls:Icon Grid.Column="2" Classes="icon small" Data="{StaticResource AlcolerIconChevronDown}" />
                    </Grid>
                    <Button.Flyout>
                      <Flyout Placement="LeftEdgeAlignedTop" FlyoutPresenterClasses="statusFlyout">
                        <ScrollViewer Width="272" MaxHeight="192" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                          <ItemsControl ItemsSource="{Binding Git.Branches}" IsEnabled="{Binding !Git.IsBusy}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:GitBranchViewModel">
                                <Button Classes="statusRow" Click="OnBranchClick" IsEnabled="{Binding !IsCurrent}">
                                  <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
                                    <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconCheck}" IsVisible="{Binding IsCurrent}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding TrackingText}" Classes="statusCount" />
                                  </Grid>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <TextBlock Text="{Binding Git.Banner}" IsVisible="{Binding Git.Banner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Margin="8,4" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AlcolerError}" />
                </StackPanel>
              </ScrollViewer>
            </Expander>
          </Border>

          <Border x:Name="PlansContainer" IsVisible="{Binding HasPlans}">
            <Expander x:Name="PlansSection" Classes="statusSection" IsExpanded="True" AutomationProperties.Name="{loc:Loc status_plans}">
              <Expander.Header><TextBlock Classes="statusHeading" Text="{loc:Loc status_plans}" /></Expander.Header>
              <ScrollViewer MaxHeight="192" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Plans}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatusPlan">
                      <Button Classes="statusRow" Click="OnPlanClick" ToolTip.Tip="{Binding Title}"
                              AutomationProperties.Name="{Binding Title}">
                        <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                          <controls:Icon Classes="icon" Data="M9 6h11M9 12h11M9 18h11M3 6l1 1 2-2M3 12l1 1 2-2M3 18l1 1 2-2" />
                          <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Expander>
          </Border>

          <Border x:Name="ProgressContainer" IsVisible="{Binding HasTodos}">
            <Expander x:Name="ProgressSection" Classes="statusSection" IsExpanded="True" AutomationProperties.Name="{loc:Loc status_progress}">
              <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="statusHeading" Text="{loc:Loc status_progress}" />
                  <TextBlock Classes="statusCount" Text="{Binding TodoCountText}" />
                </StackPanel>
              </Expander.Header>
              <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel>
                  <Button x:Name="EarlierTodosButton" Classes="statusRow" IsVisible="{Binding !!EarlierTodos.Count}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <controls:Icon Classes="icon small" Data="m15 18-6-6 6-6" />
                      <TextBlock Text="{Binding EarlierTodosText}" FontSize="14"
                                 Foreground="{DynamicResource AlcolerTextSecondary}" />
                    </StackPanel>
                    <ToolTip.Tip>
                      <ToolTip Classes="statusPreview">
                        <ScrollViewer Width="288" MaxHeight="320" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                          <ItemsControl ItemsSource="{Binding EarlierTodos}" ItemTemplate="{StaticResource TodoRow}" />
                        </ScrollViewer>
                      </ToolTip>
                    </ToolTip.Tip>
                    <Button.Flyout>
                      <Flyout Placement="LeftEdgeAlignedTop" FlyoutPresenterClasses="statusFlyout">
                        <ScrollViewer Width="288" MaxHeight="320" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                          <ItemsControl ItemsSource="{Binding EarlierTodos}" ItemTemplate="{StaticResource TodoRow}" />
                        </ScrollViewer>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <ItemsControl ItemsSource="{Binding VisibleTodos}" ItemTemplate="{StaticResource TodoRow}" />
                  <Button x:Name="LaterTodosButton" Classes="statusRow" IsVisible="{Binding !!LaterTodos.Count}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <controls:Icon Classes="icon small" Data="m15 18-6-6 6-6" />
                      <TextBlock Text="{Binding LaterTodosText}" FontSize="14"
                                 Foreground="{DynamicResource AlcolerTextSecondary}" />
                    </StackPanel>
                    <ToolTip.Tip>
                      <ToolTip Classes="statusPreview">
                        <ScrollViewer Width="288" MaxHeight="320" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                          <ItemsControl ItemsSource="{Binding LaterTodos}" ItemTemplate="{StaticResource TodoRow}" />
                        </ScrollViewer>
                      </ToolTip>
                    </ToolTip.Tip>
                    <Button.Flyout>
                      <Flyout Placement="LeftEdgeAlignedTop" FlyoutPresenterClasses="statusFlyout">
                        <ScrollViewer Width="288" MaxHeight="320" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                          <ItemsControl ItemsSource="{Binding LaterTodos}" ItemTemplate="{StaticResource TodoRow}" />
                        </ScrollViewer>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </ScrollViewer>
            </Expander>
          </Border>

          <Border x:Name="TerminalsContainer" IsVisible="{Binding HasTerminals}">
            <Expander x:Name="TerminalsSection" Classes="statusSection" IsExpanded="False" AutomationProperties.Name="{loc:Loc status_terminals}">
              <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="statusHeading" Text="{loc:Loc status_terminals}" />
                  <TextBlock Classes="statusCount" Text="{Binding TerminalCountText}" />
                </StackPanel>
              </Expander.Header>
              <ScrollViewer MaxHeight="192" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Terminals}" ItemTemplate="{StaticResource TerminalRow}" />
              </ScrollViewer>
            </Expander>
          </Border>

          <Border x:Name="AgentsContainer" IsVisible="{Binding HasAgents}">
            <Expander x:Name="AgentsSection" Classes="statusSection" IsExpanded="False" AutomationProperties.Name="{loc:Loc status_agents}">
              <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="statusHeading" Text="{loc:Loc status_agents}" />
                  <TextBlock x:Name="AgentRunningCount" Classes="statusCount" Text="{Binding AgentCountText}"
                             IsVisible="{Binding !!Agents.Count}" />
                </StackPanel>
              </Expander.Header>
              <ScrollViewer MaxHeight="192" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Agents}" ItemTemplate="{StaticResource AgentRow}" />
                  <Border x:Name="EndedAgentsContainer" IsVisible="{Binding !!EndedAgents.Count}">
                    <Button x:Name="EndedAgentsButton" Classes="statusRow" AutomationProperties.Name="{loc:Loc status_ended_agents}">
                      <Grid ColumnDefinitions="16,*,Auto,14" ColumnSpacing="8">
                        <controls:Icon Classes="icon" Data="M9 12l2 2 4-4M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z" />
                        <TextBlock Grid.Column="1" Text="{loc:Loc status_ended}" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="statusCount" Text="{Binding EndedAgents.Count}" />
                        <controls:Icon Grid.Column="3" Classes="icon small" Data="{StaticResource AlcolerIconChevronRight}" />
                      </Grid>
                      <Button.Flyout>
                        <Flyout Placement="LeftEdgeAlignedTop" FlyoutPresenterClasses="statusFlyout">
                          <ScrollViewer Width="288" MaxHeight="320" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ItemsControl ItemsSource="{Binding EndedAgents}" ItemTemplate="{StaticResource AgentRow}" />
                          </ScrollViewer>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Expander>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <StackPanel x:Name="CardControls" IsVisible="{Binding #StatusView.IsExpanded}" Orientation="Horizontal" Spacing="4"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
        <Button x:Name="DisplayModeButton" Classes="cardControl" ToolTip.Tip="{loc:Loc status_display_mode}"
                AutomationProperties.Name="{loc:Loc status_display_mode}">
          <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconMore}" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{loc:Loc status_auto_expand}" Click="OnAutoExpandClick" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="MinimizeButton" Classes="cardControl" Click="OnMinimizeClick" ToolTip.Tip="{loc:Loc status_minimize}"
                AutomationProperties.Name="{loc:Loc status_minimize}">
          <controls:Icon Classes="icon small" Data="M4 14h6v6M20 10h-6V4M10 14l-7 7M14 10l7-7" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
