<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Alcoler.Controls"
             xmlns:loc="using:Alcoler.Localization"
             x:Class="Alcoler.Views.ImageViewerOverlay"
             Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.Name="{loc:Loc imageviewer_title}">
  <Grid x:Name="Backdrop" Background="{DynamicResource AlcolerOverlay}" PointerPressed="OnBackdropPointerPressed">
    <Grid RowDefinitions="Auto,*">
      <Border x:Name="Toolbar" Grid.Row="0" Margin="24,16,24,8"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Background="{DynamicResource AlcolerPopover}"
              CornerRadius="{DynamicResource AlcolerRadiusLarge}" Padding="10,6"
              BoxShadow="0 12 32 0 #66000000">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock x:Name="FileNameLabel" MaxWidth="320" VerticalAlignment="Center"
                     FontSize="{DynamicResource AlcolerFontSmall}" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource AlcolerTextPrimary}" />
          <Border Width="1" Height="18" VerticalAlignment="Center" Background="{DynamicResource AlcolerSurfaceHigh}" />
          <StackPanel x:Name="ZoomControls" Orientation="Horizontal" Spacing="2" IsEnabled="False">
            <Button x:Name="ZoomOutButton" Classes="icon tiny" Content="−" Click="OnZoomOutClick"
                    ToolTip.Tip="{loc:Loc imageviewer_zoom_out}" AutomationProperties.Name="{loc:Loc imageviewer_zoom_out}" />
            <TextBlock x:Name="ZoomLabel" Text="{loc:Loc imageviewer_fit}" MinWidth="44" TextAlignment="Center"
                       VerticalAlignment="Center" FontSize="{DynamicResource AlcolerFontSmall}"
                       Foreground="{DynamicResource AlcolerTextSecondary}" />
            <Button x:Name="ZoomInButton" Classes="icon tiny" Content="+" Click="OnZoomInClick"
                    ToolTip.Tip="{loc:Loc imageviewer_zoom_in}" AutomationProperties.Name="{loc:Loc imageviewer_zoom_in}" />
            <Button x:Name="ActualSizeButton" Classes="ghost" Content="100%" Click="OnActualSizeClick"
                    Padding="6,3" FontSize="{DynamicResource AlcolerFontSmall}" ToolTip.Tip="{loc:Loc imageviewer_actual_size}" />
            <Button x:Name="FitButton" Classes="ghost" Content="{loc:Loc imageviewer_fit}" Click="OnFitClick"
                    Padding="6,3" FontSize="{DynamicResource AlcolerFontSmall}" ToolTip.Tip="{loc:Loc imageviewer_fit_tooltip}" />
          </StackPanel>
          <Button x:Name="CloseImageButton" Classes="icon" Click="OnCloseClick"
                  ToolTip.Tip="{loc:Loc imageviewer_close}" AutomationProperties.Name="{loc:Loc imageviewer_close}">
            <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconX}" />
          </Button>
        </StackPanel>
      </Border>
      <Grid Grid.Row="1" Margin="24,8,24,24">
        <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ScrollViewer>
        <TextBlock x:Name="StatusLabel" Text="{loc:Loc imageviewer_loading}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="560" Foreground="{DynamicResource AlcolerTextSecondary}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
