<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Alcoler.ViewModel"
        xmlns:controls="using:Alcoler.Controls"
        x:Class="Alcoler.Views.ModelConfigurationDialog"
        x:DataType="vm:ModelConfigurationViewModel"
        Title="{Binding Title}" Width="660" Height="720" MinWidth="560" MinHeight="480"
        CanResize="True" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        SystemDecorations="None" Background="{DynamicResource AlcolerBackground}">
  <Window.Styles>
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
      <Setter Property="Width" Value="32" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid x:Name="SwitchSurface">
            <Border x:Name="SwitchTrack" Height="18" CornerRadius="9" Background="{DynamicResource AlcolerSurfaceHigh}" VerticalAlignment="Center" />
            <Canvas Width="28" Height="14" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center">
              <Panel x:Name="PART_SwitchKnob" Width="14" Height="14" Background="Transparent" />
              <Panel x:Name="PART_MovingKnobs" Width="14" Height="14">
                <Ellipse x:Name="SwitchThumb" Fill="{DynamicResource AlcolerTextPrimary}" />
              </Panel>
            </Canvas>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchTrack">
      <Setter Property="Background" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchThumb">
      <Setter Property="Fill" Value="{DynamicResource AlcolerBackground}" />
    </Style>
    <Style Selector="ToggleSwitch /template/ Grid#SwitchSurface">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleSwitch:focus-visible /template/ Grid#SwitchSurface">
      <Setter Property="Background" Value="{DynamicResource AlcolerHover}" />
    </Style>
    <Style Selector="ToggleSwitch:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="{DynamicResource AlcolerFontBase}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
    </Style>
    <Style Selector="TextBlock.help">
      <Setter Property="FontSize" Value="{DynamicResource AlcolerFontSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadiusLarge}" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadiusLarge}" />
    </Style>
    <Style Selector="ToggleButton.chip">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadiusLarge}" />
      <Setter Property="Background" Value="{DynamicResource AlcolerCard}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="ChipSurface" Background="{TemplateBinding Background}"
                  BorderThickness="0" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <Border x:Name="ChipCheck" Width="12" Height="12" BorderThickness="0" CornerRadius="2" VerticalAlignment="Center">
                <controls:Icon Width="10" Height="10" Stroke="{DynamicResource AlcolerBrandText}" StrokeThickness="2" Data="m5 12 4 4 10-10" IsVisible="{TemplateBinding IsChecked}" />
              </Border>
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.chip:pointerover">
      <Setter Property="Background" Value="{DynamicResource AlcolerHover}" />
    </Style>
    <Style Selector="ToggleButton.chip:checked">
      <Setter Property="Background" Value="{DynamicResource AlcolerSelected}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="ToggleButton.chip:checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="ToggleButton.chip:pressed">
      <Setter Property="Background" Value="{DynamicResource AlcolerSelected}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="ToggleButton.chip:disabled">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.chip:focus-visible">
      <Setter Property="Background" Value="{DynamicResource AlcolerHover}" />
    </Style>
    <Style Selector="ToggleButton.chip /template/ Border#ChipCheck">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
    </Style>
    <Style Selector="ToggleButton.chip:checked /template/ Border#ChipCheck">
      <Setter Property="Background" Value="{DynamicResource AlcolerBrand}" />
    </Style>
    <Style Selector="ToggleButton.disclosure">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,5" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="DisclosureSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                  BorderThickness="0" CornerRadius="4">
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.disclosure:checked">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
    </Style>
    <Style Selector="ToggleButton.disclosure:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="ToggleButton.disclosure:checked:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="ToggleButton.disclosure:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="ToggleButton.disclosure:focus-visible">
      <Setter Property="Background" Value="{DynamicResource AlcolerHover}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextPrimary}" />
    </Style>
    <Style Selector="Expander.advanced">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel Spacing="4">
            <ToggleButton Classes="disclosure" HorizontalContentAlignment="Left" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Grid>
                  <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconChevronRight}" IsVisible="{Binding !$parent[Expander].IsExpanded}" />
                  <controls:Icon Classes="icon small" Data="m6 9 6 6 6-6" IsVisible="{Binding $parent[Expander].IsExpanded}" />
                </Grid>
                <ContentPresenter Content="{TemplateBinding Header}" />
              </StackPanel>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding Content}" IsVisible="{TemplateBinding IsExpanded}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Border.reasoningChip Button">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="18" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.reasoningChip:pointerover Button">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.reasoningChip:focus-within Button">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.helpIcon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="3" />
    </Style>
  </Window.Styles>
  <Border BorderThickness="0" CornerRadius="12" Background="{DynamicResource AlcolerBackground}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <StackPanel Spacing="16" Margin="0,0,0,20">
      <Grid ColumnDefinitions="*,Auto" Background="Transparent" PointerPressed="OnHeaderPointerPressed">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button x:Name="CloseButton" Grid.Column="1" Classes="icon" Click="OnCancelClick" ToolTip.Tip="Close model configuration" AutomationProperties.Name="Close model configuration">
          <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconX}" />
        </Button>
      </Grid>
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Smart configuration" FontWeight="Medium" VerticalAlignment="Center" />
          <Button Classes="ghost helpIcon" ToolTip.Tip="{Binding SmartConfigurationHelp}" AutomationProperties.Name="About smart configuration">
            <controls:Icon Classes="icon small" Data="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM12 11v6M12 7h.01" />
          </Button>
        </StackPanel>
        <ToggleSwitch x:Name="SmartConfigurationToggle" Grid.Column="1" IsChecked="{Binding Draft.SmartConfiguration, Mode=TwoWay}" AutomationProperties.Name="Smart configuration" />
      </Grid>
    </StackPanel>
    <ScrollViewer x:Name="EditorScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="18" Margin="0,0,12,20">
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="Model ID" />
          <TextBox x:Name="ModelIdBox" Text="{Binding Draft.ModelId, Mode=TwoWay}" Watermark="Model ID" FontFamily="{DynamicResource AlcolerFontMonospace}" AutomationProperties.Name="Model ID" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="Context window" ToolTip.Tip="Maximum input and output context in tokens. Leave empty in smart mode to inherit the catalog value." />
          <TextBox x:Name="ContextWindowBox" Text="{Binding Draft.ContextWindowTokens, Mode=TwoWay}" Watermark="{Binding Draft.ContextWindowPlaceholder}" AutomationProperties.Name="Context window" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="Max output tokens" ToolTip.Tip="The model's output token limit, not a request to use that many tokens." />
          <TextBox x:Name="MaxOutputTokensBox" Text="{Binding Draft.MaxOutputTokens, Mode=TwoWay}" Watermark="{Binding Draft.MaxOutputTokensPlaceholder}" AutomationProperties.Name="Max output tokens" />
        </StackPanel>
        <Expander x:Name="AdvancedExpander" Classes="advanced" Header="Advanced" IsExpanded="{Binding IsAdvancedExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="18" Margin="0,12,0,0">
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="Input modalities" />
              <WrapPanel>
                <ToggleButton Classes="chip" IsChecked="True" IsEnabled="False" AutomationProperties.Name="Text input is required">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Text" />
                    <controls:Icon Classes="icon small" Data="M6 10h12v11H6Zm3 0V6a3 3 0 0 1 6 0v4" />
                  </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ImageToggle" Classes="chip" Content="Image" IsChecked="{Binding Draft.EffectiveSupportsImage, Mode=TwoWay}" AutomationProperties.Name="Image input" />
                <ToggleButton x:Name="VideoToggle" Classes="chip" Content="Video" IsChecked="{Binding Draft.EffectiveSupportsVideo, Mode=TwoWay}" AutomationProperties.Name="Video input" />
                <ToggleButton x:Name="PdfToggle" Classes="chip" Content="PDF" IsChecked="{Binding Draft.EffectiveSupportsPdf, Mode=TwoWay}" AutomationProperties.Name="PDF input" />
              </WrapPanel>
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="Capabilities" />
              <TextBlock Classes="help" Text="These describe model support. Enabling a capability does not force that feature on every request." />
              <WrapPanel>
                <ToggleButton x:Name="StructuredOutputToggle" Classes="chip" Content="Structured output" IsChecked="{Binding Draft.EffectiveSupportsJsonSchemaOutput, Mode=TwoWay}" AutomationProperties.Name="Structured output capability" />
                <ToggleButton x:Name="NativeWebSearchToggle" Classes="chip" Content="Native web search" IsChecked="{Binding Draft.EffectiveSupportsNativeWebSearch, Mode=TwoWay}" AutomationProperties.Name="Native web search capability" />
                <ToggleButton x:Name="MidConversationSystemToggle" Classes="chip" Content="System in conversation" IsChecked="{Binding Draft.EffectiveSupportsMidConversationSystem, Mode=TwoWay}" AutomationProperties.Name="System in conversation capability" />
              </WrapPanel>
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="Reasoning levels (ordered)" />
              <TextBlock Classes="help" Text="Use unique values in ascending effort order. Edit a value, move it up or down, or remove it." />
              <ItemsControl ItemsSource="{Binding ReasoningLevels}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReasoningLevelViewModel">
                    <Border Classes="reasoningChip" BorderThickness="0" CornerRadius="6" Padding="4" Margin="0,0,8,8">
                      <Grid Width="84" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="0">
                        <TextBox Grid.ColumnSpan="3" Text="{Binding Value, Mode=TwoWay}" MinHeight="24" Padding="4,2" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Reasoning level" />
                        <Button Grid.Row="1" Grid.Column="0" Classes="icon" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move reasoning level up" AutomationProperties.Name="Move reasoning level up">
                          <controls:Icon Classes="icon small" Data="m6 14 6-6 6 6" />
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Classes="icon" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move reasoning level down" AutomationProperties.Name="Move reasoning level down">
                          <controls:Icon Classes="icon small" Data="m6 10 6 6 6-6" />
                        </Button>
                        <Button Grid.Row="1" Grid.Column="2" Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove reasoning level" AutomationProperties.Name="Remove reasoning level">
                          <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconX}" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="NewReasoningLevelBox" Text="{Binding NewReasoningLevel, Mode=TwoWay}" Watermark="New reasoning level" AutomationProperties.Name="New reasoning level" />
                <Button x:Name="AddReasoningLevelButton" Grid.Column="1" Classes="secondary action" Content="Add" Command="{Binding AddReasoningLevelCommand}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="Reasoning level mapping (JSON / CEL)" />
              <TextBlock Classes="help" Text="An object-valued JSON or restricted CEL expression. Use reasoningLevel to map each configured level to provider request fields. Empty inherits the catalog mapping." />
              <TextBox x:Name="ReasoningMappingBox" Text="{Binding Draft.ReasoningMapping, Mode=TwoWay}" Watermark="{Binding Draft.ReasoningMappingPlaceholder}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="{DynamicResource AlcolerFontMonospace}" MinHeight="120" MaxHeight="240" AutomationProperties.Name="Reasoning level mapping" />
            </StackPanel>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Spacing="12">
      <ScrollViewer MaxHeight="90" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasError}">
        <TextBlock x:Name="ValidationError" Text="{Binding Error}" Foreground="{DynamicResource AlcolerError}" TextWrapping="Wrap" FontSize="{DynamicResource AlcolerFontSmall}" />
      </ScrollViewer>
      <Grid ColumnDefinitions="*,Auto">
        <Button x:Name="RestoreButton" Classes="ghost action" Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}" HorizontalAlignment="Left" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CancelButton" Classes="secondary action" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
          <Button x:Name="SaveButton" Classes="primary action" Content="Save" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
  </Border>
</Window>
