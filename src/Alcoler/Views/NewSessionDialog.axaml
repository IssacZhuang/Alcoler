<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Alcoler.Controls"
        x:Class="Alcoler.Views.NewSessionDialog"
        Title="New session"
        Width="640" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AlcolerBackground}">
  <Window.Styles>
    <Style Selector="TextBlock.description">
      <Setter Property="FontSize" Value="{DynamicResource AlcolerFontSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox.sessionField">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadiusLarge}" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadiusLarge}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto">
    <Grid Margin="24,16,16,0" ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconPlus}" />
        <TextBlock Text="New session" FontSize="{DynamicResource AlcolerFontSmall}"
                   Foreground="{DynamicResource AlcolerTextSecondary}" />
      </StackPanel>
      <Button x:Name="CloseButton" Grid.Column="1" Classes="icon" Click="OnCancelClick"
              ToolTip.Tip="Close" AutomationProperties.Name="Close new session">
        <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconX}" />
      </Button>
    </Grid>

    <StackPanel Grid.Row="1" Margin="24,24,24,28" Spacing="24">
      <StackPanel Spacing="8" Margin="0,0,0,4">
        <TextBlock Text="Start a new session" FontSize="28" FontWeight="Medium" HorizontalAlignment="Center" />
        <TextBlock Classes="description" Text="Choose a workspace for your next task." HorizontalAlignment="Center" />
      </StackPanel>
      <Border Background="{DynamicResource AlcolerSurface}" BorderThickness="0" CornerRadius="{DynamicResource AlcolerRadius2XLarge}">
        <StackPanel>
          <StackPanel Spacing="10" Margin="16">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconFolder}" />
              <TextBlock Text="Workspace" FontWeight="Medium" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="WorkspaceBox" Classes="sessionField" Watermark="Path to the workspace folder"
                       TextChanged="OnWorkspaceChanged" AutomationProperties.Name="Workspace root" />
              <Button x:Name="BrowseButton" Grid.Column="1" Classes="secondary action" Content="Browse"
                      Click="OnBrowseClick" />
            </Grid>
            <TextBlock Classes="description" Text="The agent will work in this folder." />
          </StackPanel>
          <Border BorderThickness="0"
                  Background="{DynamicResource AlcolerInput}" CornerRadius="0,0,16,16" Padding="16">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Session title" FontWeight="Medium" />
                <TextBlock Classes="description" Text="Optional" VerticalAlignment="Center" />
              </StackPanel>
              <TextBox x:Name="TitleBox" Classes="sessionField" Watermark="Name this session"
                       AutomationProperties.Name="Session title" />
              <TextBlock Classes="description" Text="Shown in the sidebar. Leave blank to use the default title." />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
      <TextBlock x:Name="WorkspaceError" Text="Enter a workspace folder to continue." IsVisible="False"
                 TextWrapping="Wrap" FontSize="{DynamicResource AlcolerFontSmall}"
                 Foreground="{DynamicResource AlcolerError}" />
    </StackPanel>

    <Border Grid.Row="2" BorderThickness="0" Padding="24,16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Classes="description" Text="A fresh conversation in your workspace." VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CancelButton" Classes="secondary action" Content="Cancel" Click="OnCancelClick" IsCancel="True" />
          <Button x:Name="CreateButton" Classes="primary action" Content="Create session" Click="OnCreateClick" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
