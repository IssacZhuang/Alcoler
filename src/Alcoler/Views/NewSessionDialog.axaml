<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Alcoler.Controls"
        xmlns:loc="using:Alcoler.Localization"
        x:Class="Alcoler.Views.NewSessionDialog"
        Title="{loc:Loc newtask_title}"
        Width="640" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AlcolerBackground}">
  <Window.Styles>
    <Style Selector="TextBlock.description">
      <Setter Property="FontSize" Value="{DynamicResource AlcolerFontSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource AlcolerTextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox.sessionField">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadiusLarge}" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadiusLarge}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto">
    <Grid Margin="24,16,16,0" ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconPlus}" />
        <TextBlock Text="{loc:Loc newtask_title}" FontSize="{DynamicResource AlcolerFontSmall}"
                   Foreground="{DynamicResource AlcolerTextSecondary}" />
      </StackPanel>
      <Button x:Name="CloseButton" Grid.Column="1" Classes="icon" Click="OnCancelClick"
              ToolTip.Tip="{loc:Loc newtask_close_tooltip}" AutomationProperties.Name="{loc:Loc newtask_close}">
        <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconX}" />
      </Button>
    </Grid>

    <StackPanel Grid.Row="1" Margin="24,24,24,28" Spacing="24">
      <StackPanel Spacing="8" Margin="0,0,0,4">
        <TextBlock Text="{loc:Loc newtask_heading}" FontSize="28" FontWeight="Medium" HorizontalAlignment="Center" />
        <TextBlock Classes="description" Text="{loc:Loc newtask_description}" HorizontalAlignment="Center" />
      </StackPanel>
      <Border Background="{DynamicResource AlcolerSurface}" BorderThickness="0" CornerRadius="{DynamicResource AlcolerRadius2XLarge}">
        <StackPanel>
          <StackPanel Spacing="10" Margin="16">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconFolder}" />
              <TextBlock Text="{loc:Loc newtask_workspace}" FontWeight="Medium" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="WorkspaceBox" Classes="sessionField" Watermark="{loc:Loc newtask_workspace_watermark}"
                       TextChanged="OnWorkspaceChanged" AutomationProperties.Name="{loc:Loc newtask_workspace_root}" />
              <Button x:Name="BrowseButton" Grid.Column="1" Classes="secondary action" Content="{loc:Loc newtask_browse}"
                      Click="OnBrowseClick" />
            </Grid>
            <TextBlock Classes="description" Text="{loc:Loc newtask_workspace_help}" />
          </StackPanel>
          <Border BorderThickness="0"
                  Background="{DynamicResource AlcolerInput}" CornerRadius="0,0,16,16" Padding="16">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{loc:Loc newtask_session_title}" FontWeight="Medium" />
                <TextBlock Classes="description" Text="{loc:Loc newtask_optional}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBox x:Name="TitleBox" Classes="sessionField" Watermark="{loc:Loc newtask_title_watermark}"
                       AutomationProperties.Name="{loc:Loc newtask_session_title}" />
              <TextBlock Classes="description" Text="{loc:Loc newtask_title_help}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
      <TextBlock x:Name="WorkspaceError" Text="{loc:Loc newtask_workspace_required}" IsVisible="False"
                 TextWrapping="Wrap" FontSize="{DynamicResource AlcolerFontSmall}"
                 Foreground="{DynamicResource AlcolerError}" />
    </StackPanel>

    <Border Grid.Row="2" BorderThickness="0" Padding="24,16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Classes="description" Text="{loc:Loc newtask_footer}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CancelButton" Classes="secondary action" Content="{loc:Loc common_cancel}" Click="OnCancelClick" IsCancel="True" />
          <Button x:Name="CreateButton" Classes="primary action" Content="{loc:Loc newtask_create}" Click="OnCreateClick" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
