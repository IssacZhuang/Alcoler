<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alcoler.ViewModel"
             xmlns:controls="using:Alcoler.Controls"
             xmlns:loc="using:Alcoler.Localization"
             x:Class="Alcoler.Views.SidebarView"
             x:DataType="vm:WorkbenchViewModel">
  <UserControl.Styles>
    <Style Selector="Button.sessionItem">
      <Setter Property="Background" Value="{DynamicResource AlcolerTransparent}" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadius}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.sessionItem.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerSelected}" />
    </Style>
    <Style Selector="Button.groupHeader">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.sidebarAction">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Height" Value="32" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.showMore">
      <Setter Property="Background" Value="{DynamicResource AlcolerTransparent}" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadius}" />
      <Setter Property="Padding" Value="32,4,8,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.showMore:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.showMore:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
    </Style>
    <Style Selector="Button.archiveToggle.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerSelected}" />
    </Style>
    <Style Selector="Button.sessionItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.sessionItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter,
                     Button.groupHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.groupHeader:focus-visible /template/ ContentPresenter#PART_ContentPresenter,
                     Button.sidebarAction:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.sidebarAction:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AlcolerSurfaceHigh}" />
    </Style>
    <Style Selector="controls|Icon.sessionSpinner.running">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.sessionBadge">
      <Setter Property="Background" Value="{DynamicResource AlcolerSelected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlcolerSuccess}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource AlcolerRadiusFull}" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <DockPanel Background="{DynamicResource AlcolerSidebar}">
    <Grid DockPanel.Dock="Top" Height="40" Margin="12,0,8,0" ColumnDefinitions="*,Auto"
          PointerPressed="OnTitleBarPointerPressed">
      <Button Grid.Column="1" Classes="icon tiny" Command="{Binding ToggleSidebarCommand}"
              ToolTip.Tip="{loc:Loc sidebar_collapse_tooltip}" AutomationProperties.Name="{loc:Loc sidebar_collapse}">
        <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconPanel}" />
      </Button>
    </Grid>
    <StackPanel DockPanel.Dock="Top" Margin="8,8,8,12" Spacing="2">
      <Button x:Name="PART_NewSession" Classes="sidebarAction" Click="OnNewSessionClick" AutomationProperties.Name="{loc:Loc sidebar_new_task}">
        <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
          <controls:Icon Classes="icon" Data="{StaticResource AlcolerIconCirclePlus}" />
          <TextBlock Grid.Column="1" Text="{loc:Loc sidebar_new_task}" FontSize="{DynamicResource AlcolerFontBase}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="Ctrl+N" FontSize="{DynamicResource AlcolerFontXs}" Foreground="{DynamicResource AlcolerTextTertiary}" VerticalAlignment="Center" />
        </Grid>
      </Button>
    </StackPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,0,10,4">
      <TextBlock Text="{Binding Sidebar.HeaderTitle}" FontSize="{DynamicResource AlcolerFontSmall}" VerticalAlignment="Center" Foreground="{DynamicResource AlcolerTextSecondary}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
        <Button Classes="icon tiny archiveToggle" Classes.active="{Binding Sidebar.IsArchivedView}"
                Click="OnToggleArchivedClick" ToolTip.Tip="{Binding Sidebar.ArchivedToggleToolTip}"
                AutomationProperties.Name="{loc:Loc sidebar_toggle_archived}">
          <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconArchive}" />
        </Button>
        <Button Classes="icon tiny" Click="OnRefreshClick" ToolTip.Tip="{loc:Loc sidebar_refresh_tooltip}" AutomationProperties.Name="{loc:Loc sidebar_refresh}">
          <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconRefresh}" />
        </Button>
      </StackPanel>
    </Grid>
    <Border DockPanel.Dock="Bottom" Padding="8,8,8,12">
      <Button x:Name="PART_Settings" Classes="sidebarAction" Click="OnSettingsClick" AutomationProperties.Name="{loc:Loc settings_title}">
        <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
          <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconSettings}" />
          <TextBlock Grid.Column="1" Text="{loc:Loc sidebar_preferences}" FontSize="{DynamicResource AlcolerFontBase}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="Ctrl+," FontSize="{DynamicResource AlcolerFontXs}" Foreground="{DynamicResource AlcolerTextTertiary}" VerticalAlignment="Center" />
        </Grid>
      </Button>
    </Border>
    <Grid>
      <TextBlock x:Name="PART_SidebarEmpty" Text="{Binding Sidebar.EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="0,20,0,0" FontSize="{DynamicResource AlcolerFontSmall}" Foreground="{DynamicResource AlcolerTextTertiary}"
                 IsVisible="{Binding Sidebar.Groups.Count, Converter={StaticResource AlcolerZeroToVisible}}" />
      <TextBlock Text="{loc:Loc sidebar_loading}" FontSize="{DynamicResource AlcolerFontSmall}" Margin="16,8" VerticalAlignment="Top"
                 Foreground="{DynamicResource AlcolerTextSecondary}" IsVisible="{Binding Sidebar.IsLoading}" />
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <ItemsControl ItemsSource="{Binding Sidebar.Groups}" Margin="8,0,8,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SessionGroupViewModel">
              <StackPanel Margin="0,4,0,12">
                <Grid ColumnDefinitions="*,Auto">
                  <Button Classes="groupHeader" Click="OnGroupClick" ToolTip.Tip="{Binding WorkspaceRoot}">
                    <Button.ContextFlyout>
                      <MenuFlyout>
                        <MenuItem Header="{loc:Loc sidebar_remove_project_confirm}" Click="OnRemoveProjectClick"
                                  ToolTip.Tip="{loc:Loc sidebar_remove_project_tooltip}" />
                      </MenuFlyout>
                    </Button.ContextFlyout>
                    <Grid ColumnDefinitions="14,*,12" ColumnSpacing="8">
                      <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconFolder}" />
                      <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" FontSize="{DynamicResource AlcolerFontBase}" FontFamily="{DynamicResource AlcolerFontPrimary}" TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" Foreground="{DynamicResource AlcolerTextSecondary}" />
                      <controls:Icon Grid.Column="2" Classes="icon small" Data="{StaticResource AlcolerIconChevronRight}"
                            IsVisible="{Binding !IsExpanded}" Stroke="{DynamicResource AlcolerTextTertiary}" />
                      <controls:Icon Grid.Column="2" Classes="icon small" Data="{StaticResource AlcolerIconChevronDown}"
                            IsVisible="{Binding IsExpanded}" Stroke="{DynamicResource AlcolerTextTertiary}" />
                    </Grid>
                  </Button>
                  <Button Grid.Column="1" Classes="icon tiny projectNewTask" Click="OnProjectNewTaskClick"
                          ToolTip.Tip="{loc:Loc sidebar_project_new_task_tooltip}" AutomationProperties.Name="{loc:Loc sidebar_project_new_task}">
                    <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconCirclePlus}" />
                  </Button>
                </Grid>
                <StackPanel Margin="0,2,0,0" IsVisible="{Binding IsExpanded}">
                  <ItemsControl ItemsSource="{Binding VisibleSessions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SessionSummaryViewModel">
                        <Button Classes="sessionItem" Classes.active="{Binding IsActive}" Click="OnSessionClick" ToolTip.Tip="{Binding DisplayTitle}"
                                Background="{Binding IsActive, Converter={StaticResource AlcolerBoolBrush}, ConverterParameter=AlcolerSelected|AlcolerTransparent}">
                          <Button.ContextFlyout>
                            <MenuFlyout>
                              <MenuItem Header="{loc:Loc sidebar_archive}" Click="OnArchiveSessionClick" IsVisible="{Binding !IsArchived}" />
                              <MenuItem Header="{loc:Loc sidebar_unarchive}" Click="OnUnarchiveSessionClick" IsVisible="{Binding IsArchived}" />
                            </MenuFlyout>
                          </Button.ContextFlyout>
                          <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                              <Border x:Name="PART_ActiveIndicator" Width="4" Height="4" CornerRadius="2" HorizontalAlignment="Center"
                                      Background="{DynamicResource AlcolerTextSecondary}" IsVisible="{Binding ShowActiveDot}" />
                              <Border x:Name="PART_CompletedIndicator" Width="6" Height="6" CornerRadius="3"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Background="{DynamicResource AlcolerInfo}" IsVisible="{Binding IsCompleted}"
                                      ToolTip.Tip="{loc:Loc sidebar_completed}" AutomationProperties.Name="{loc:Loc sidebar_completed}" />
                              <Border x:Name="PART_FailedIndicator" Width="6" Height="6" CornerRadius="3"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Background="{DynamicResource AlcolerError}" IsVisible="{Binding IsFailed}"
                                      ToolTip.Tip="{loc:Loc sidebar_failed}" AutomationProperties.Name="{loc:Loc sidebar_failed}" />
                              <controls:Icon x:Name="PART_RunningIndicator" Classes="icon small sessionSpinner"
                                             Classes.running="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                             RenderTransformOrigin="50%,50%" Stroke="{DynamicResource AlcolerTextSecondary}"
                                             Data="M12 3a9 9 0 1 0 9 9" ToolTip.Tip="{Binding ActivityLabel}"
                                             AutomationProperties.Name="{Binding ActivityLabel}">
                                <controls:Icon.RenderTransform>
                                  <RotateTransform />
                                </controls:Icon.RenderTransform>
                              </controls:Icon>
                            </Grid>
                            <TextBlock Grid.Column="1" Classes="sessionTitle" Text="{Binding DisplayTitle}" FontSize="{DynamicResource AlcolerFontBase}" FontFamily="{DynamicResource AlcolerFontPrimary}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock x:Name="PART_SessionTime" Grid.Column="2" Classes="sessionTime" Text="{Binding UpdatedAtText}" FontSize="{DynamicResource AlcolerFontSmall}"
                                       IsVisible="{Binding !IsAwaitingConfirmation}"
                                       VerticalAlignment="Center" Foreground="{DynamicResource AlcolerTextSecondary}" />
                            <Border x:Name="PART_AwaitingIndicator" Grid.Column="2" Classes="sessionBadge"
                                    IsVisible="{Binding IsAwaitingConfirmation}"
                                    ToolTip.Tip="{Binding ActivityLabel}"
                                    AutomationProperties.Name="{Binding ActivityLabel}">
                              <TextBlock Text="{loc:Loc sidebar_waiting_for_confirmation}" FontSize="{DynamicResource AlcolerFontXs}"
                                         Foreground="{DynamicResource AlcolerSuccess}" VerticalAlignment="Center" />
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasSessionOverflow}">
                    <Button Classes="showMore" Click="OnShowMoreClick" IsVisible="{Binding CanShowMore}"
                            ToolTip.Tip="{loc:Loc sidebar_show_more_tooltip}" AutomationProperties.Name="{loc:Loc sidebar_show_more}">
                      <TextBlock Text="{loc:Loc sidebar_show_more_text}" FontSize="{DynamicResource AlcolerFontSmall}" Foreground="{DynamicResource AlcolerTextSecondary}" VerticalAlignment="Center" />
                    </Button>
                    <Button Classes="icon tiny" Click="OnCollapseSessionsClick" IsVisible="{Binding CanCollapse}"
                            ToolTip.Tip="{loc:Loc sidebar_show_fewer}" AutomationProperties.Name="{loc:Loc sidebar_show_fewer}">
                      <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconChevronUp}" Stroke="{DynamicResource AlcolerTextSecondary}" />
                    </Button>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
