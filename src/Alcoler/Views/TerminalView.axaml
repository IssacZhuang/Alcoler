<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Alcoler.Views"
             xmlns:vm="using:Alcoler.ViewModel"
             xmlns:controls="using:Alcoler.Controls"
             xmlns:loc="using:Alcoler.Localization"
             x:Class="Alcoler.Views.TerminalView"
             x:DataType="vm:TerminalPaneViewModel">
  <DockPanel Background="{DynamicResource AlcolerTerminalBackground}">
    <Grid x:Name="PART_TerminalToolbar" DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="8" Margin="12,8" Height="28">
      <TextBlock Text="{loc:Loc status_terminal}" FontSize="{DynamicResource AlcolerFontSmall}" FontWeight="Medium"
                 Foreground="{DynamicResource AlcolerTextPrimary}" VerticalAlignment="Center" />
      <Border Grid.Column="1" Background="{DynamicResource AlcolerSurfaceHigh}"
              CornerRadius="{DynamicResource AlcolerRadius}" Padding="8,0"
              HorizontalAlignment="Left" MaxWidth="260" ToolTip.Tip="{Binding StartedFrom}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
          <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconTerminal}" />
          <TextBlock Grid.Column="1" Text="{Binding WorkspaceName}" FontSize="{DynamicResource AlcolerFontSmall}"
                     Foreground="{DynamicResource AlcolerTextPrimary}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <Ellipse Grid.Column="2" Width="5" Height="5" VerticalAlignment="Center"
                   Fill="{DynamicResource AlcolerSuccess}" IsVisible="{Binding IsConnected}" />
        </Grid>
      </Border>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button x:Name="PART_TerminalClear" Classes="icon" Click="OnClearClick" ToolTip.Tip="{loc:Loc terminal_clear}">
          <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconArchive}" />
        </Button>
        <Button x:Name="PART_TerminalStart" Content="{loc:Loc terminal_start}" Classes="ghost"
                FontSize="{DynamicResource AlcolerFontSmall}" Height="28" Padding="8,0"
                IsVisible="{Binding !IsConnected}" Click="OnStartClick"
                ToolTip.Tip="{loc:Loc terminal_start_tooltip}" />
        <Button x:Name="StopButton" Classes="icon" IsVisible="{Binding IsConnected}"
                Click="OnStopClick" ToolTip.Tip="{loc:Loc terminal_stop_tooltip}">
          <controls:Icon Classes="icon small" Data="{StaticResource AlcolerIconSquare}" />
        </Button>
      </StackPanel>
    </Grid>

    <Border Background="{DynamicResource AlcolerTerminalBackground}" Padding="12,0,12,8">
      <v:TerminalSurface x:Name="Surface" ClipToBounds="True"
                         FontFamily="{DynamicResource AlcolerFontMonospace}"
                         FontSize="{DynamicResource AlcolerFontCaption}" />
    </Border>
  </DockPanel>
</UserControl>
